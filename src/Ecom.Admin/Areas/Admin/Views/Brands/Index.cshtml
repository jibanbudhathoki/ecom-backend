@model Ecom.Application.Common.Models.PagedResult<Ecom.Application.Features.Brands.Queries.BrandDto>

@{
    ViewData["Title"] = "Brands";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Brands</h2>
        <p class="text-muted mb-0 small">Manage your product brands and collections</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-download me-1"></i> Export
        </button>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Brand
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<form method="get" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="SearchTerm" value="@Context.Request.Query["SearchTerm"]" class="form-control bg-light border-0 shadow-none" placeholder="Search brands...">
                </div>
            </div>
            <div class="col-md-4">
                <select name="SortBy" class="form-select form-select-sm border-0 bg-light rounded-pill shadow-none" onchange="this.form.submit()">
                    <option value="">Sort By</option>
                    <option value="name" selected="@(Context.Request.Query["SortBy"] == "name")">Name</option>
                </select>
            </div>
            <div class="col-md-2">
                <!-- Spacing -->
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-light btn-sm rounded-pill w-100 border text-muted">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </div>
</form>

<!-- Brands Table -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Table Header Toolbar -->
    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input shadow-none" type="checkbox" id="selectAll" style="cursor: pointer;">
            </div>
            <div class="dropdown">
                <button class="btn btn-sm btn-light border text-muted dropdown-toggle rounded-pill px-3" type="button" id="bulkActions" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                    Bulk Actions
                </button>
                <ul class="dropdown-menu shadow border-0" aria-labelledby="bulkActions">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye-slash me-2"></i>Hide Selected</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete Selected</a></li>
                </ul>
            </div>
        </div>
        <div class="text-muted small fw-semibold">@Model.TotalCount items total</div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3" style="width: 40px; border-top-left-radius: 1rem;"></th>
                        <th class="py-3 text-muted fw-semibold">Brand</th>
                        <th class="py-3 text-muted fw-semibold">Description</th>
                        <th class="py-3 text-muted fw-semibold">Products</th>
                        <th class="py-3 text-muted fw-semibold">Status</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold" style="border-top-right-radius: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-star fs-3 d-block mb-3 opacity-50"></i>
                                No brands found. Get started by adding a new one.
                            </td>
                        </tr>
                    }
                    @foreach (var brand in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                            </td>
                            <td class="py-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="bi bi-star fs-4 text-primary"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-semibold text-dark">@brand.Name</h6>
                                        <small class="text-muted">slug: @brand.Slug</small>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">
                                @(string.IsNullOrEmpty(brand.Description) ? "No description provided." : brand.Description)
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">0 Items</span>
                            </td>
                            <td class="py-3">
                                @if (brand.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-normal"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-normal"><i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i> Hidden</span>
                                }
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-slug="@brand.Slug"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>View Products</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@brand.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this brand?');">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Pagination" />
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.row-checkbox');
        const bulkActionsBtn = document.getElementById('bulkActions');

        function updateBulkActions() {
            const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
            bulkActionsBtn.disabled = !anyChecked;
            if (anyChecked) {
                bulkActionsBtn.classList.remove('btn-light', 'text-muted');
                bulkActionsBtn.classList.add('btn-primary');
            } else {
                bulkActionsBtn.classList.add('btn-light', 'text-muted');
                bulkActionsBtn.classList.remove('btn-primary');
            }
        }

        if(selectAll) {
            selectAll.addEventListener('change', function() {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateBulkActions();
            });
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                if(selectAll) selectAll.checked = allChecked;
                updateBulkActions();
            });
        });
    });
</script>

<style>
    .custom-table th {
        border-bottom: none;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .custom-table td {
        border-color: #f8f9fa;
        vertical-align: middle;
    }
    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>
