@{
    ViewData["Title"] = "Categories";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Categories</h2>
        <p class="text-muted mb-0 small">Manage your product categories and collections</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-download me-1"></i> Export
        </button>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0 shadow-none" placeholder="Search categories...">
                </div>
            </div>
            <div class="col-md-6">
                <!-- Spacing -->
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-light rounded-pill w-100 border text-muted">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Categories Table -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Table Header Toolbar -->
    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input shadow-none" type="checkbox" id="selectAll" style="cursor: pointer;">
            </div>
            <div class="dropdown">
                <button class="btn btn-sm btn-light border text-muted dropdown-toggle rounded-pill px-3" type="button" id="bulkActions" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                    Bulk Actions
                </button>
                <ul class="dropdown-menu shadow border-0" aria-labelledby="bulkActions">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye-slash me-2"></i>Hide Selected</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete Selected</a></li>
                </ul>
            </div>
        </div>
        <div class="text-muted small fw-semibold">3 items total</div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3" style="width: 40px; border-top-left-radius: 1rem;"></th>
                        <th class="py-3 text-muted fw-semibold">Category</th>
                        <th class="py-3 text-muted fw-semibold">Description</th>
                        <th class="py-3 text-muted fw-semibold">Products</th>
                        <th class="py-3 text-muted fw-semibold">Status</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold" style="border-top-right-radius: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <!-- Mock Data Row 1 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi bi-cpu fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-semibold text-dark">Electronics</h6>
                                    <small class="text-muted">slug: electronics</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">
                            Laptops, smartphones, and smartwatches.
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">124 Items</span>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-normal"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active</span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="1"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>View Products</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    <!-- Mock Data Row 2 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi bi-smartwatch fs-4 text-info"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-semibold text-dark">Wearables</h6>
                                    <small class="text-muted">Electronics > Wearables</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">
                            Smartwatches and fitness trackers.
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">42 Items</span>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-normal"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active</span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="1"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>View Products</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    <!-- Mock Data Row 3 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi bi-sunglasses fs-4 text-warning"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-semibold text-dark">Accessories</h6>
                                    <small class="text-muted">slug: accessories</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">
                            Bags, sunglasses, and daily gear.
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">0 Items</span>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-normal"><i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i> Hidden</span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="1"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>View Products</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <partial name="_Pagination" />
    </div>
</div>

<style>
    .custom-table th {
        border-bottom: none;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .custom-table td {
        border-color: #f8f9fa;
        vertical-align: middle;
    }
    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>
