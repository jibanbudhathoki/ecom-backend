@{
    ViewData["Title"] = "Create Collection";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Collections</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create Collection</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Create Collection</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill shadow-sm text-muted">Discard</a>
        <button type="submit" form="collectionForm" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-check2 me-1"></i> Save Collection
        </button>
    </div>
</div>

<form id="collectionForm">
    <div class="row g-4">
        <!-- Left Column: Main Details -->
        <div class="col-lg-8">
            <!-- Basic Info Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Collection Details</h6>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Title</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="e.g. Summer Collection, Under $50" required>
                    </div>

                    <div class="mb-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold small mb-0">Description</label>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input shadow-none" type="checkbox" id="toggleRichText">
                                <label class="form-check-label small text-muted" for="toggleRichText">Rich Text</label>
                            </div>
                        </div>
                        <div class="border rounded bg-light overflow-hidden">
                            <div id="richTextToolbar" class="bg-white border-bottom p-2 d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-bold"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-italic"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-underline"></i></button>
                                <div class="vr mx-1"></div>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-list-ol"></i></button>
                                <div class="vr mx-1"></div>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-link-45deg"></i></button>
                            </div>
                            <textarea class="form-control border-0 bg-light shadow-none" rows="4" placeholder="Brief description of the collection..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collection Type Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Collection Type</h6>
                    
                    <div class="d-flex flex-column gap-3">
                        <label class="border rounded p-3 d-flex align-items-start gap-3" style="cursor: pointer; transition: all 0.2s;" onmouseover="this.classList.add('border-primary')" onmouseout="this.classList.remove('border-primary')">
                            <div class="form-check mt-1">
                                <input class="form-check-input shadow-none" type="radio" name="collectionType" id="typeManual" checked>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Manual</h6>
                                <p class="text-muted small mb-0">Add products to this collection one by one.</p>
                            </div>
                        </label>
                        
                        <label class="border rounded p-3 d-flex align-items-start gap-3" style="cursor: pointer; transition: all 0.2s;" onmouseover="this.classList.add('border-primary')" onmouseout="this.classList.remove('border-primary')">
                            <div class="form-check mt-1">
                                <input class="form-check-input shadow-none" type="radio" name="collectionType" id="typeAutomated">
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Automated</h6>
                                <p class="text-muted small mb-0">Existing and future products that match the conditions you set will automatically be added.</p>
                            </div>
                        </label>
                    </div>
                    
                    <!-- Automated Conditions (hidden by default) -->
                    <div class="mt-4 p-3 bg-light rounded d-none" id="automatedConditionsBox">
                        <h6 class="fw-semibold small mb-2">Conditions</h6>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="small text-muted">Products must match:</span>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="conditionMatch" id="matchAll" checked>
                                <label class="form-check-label small" for="matchAll">All conditions</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="conditionMatch" id="matchAny">
                                <label class="form-check-label small" for="matchAny">Any condition</label>
                            </div>
                        </div>
                        
                        <!-- Condition Row -->
                        <div class="d-flex gap-2 align-items-center mb-2">
                            <select class="form-select form-select-sm border-0 shadow-none w-25">
                                <option>Product Tag</option>
                                <option>Price</option>
                                <option>Product Title</option>
                                <option>Inventory Stock</option>
                            </select>
                            <select class="form-select form-select-sm border-0 shadow-none w-25">
                                <option>is equal to</option>
                                <option>is greater than</option>
                                <option>contains</option>
                            </select>
                            <input type="text" class="form-control form-control-sm border-0 shadow-none flex-grow-1" placeholder="e.g. sale">
                            <button type="button" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                        </div>
                        
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 px-3 rounded-pill"><i class="bi bi-plus"></i> Add Condition</button>
                    </div>
                </div>
            </div>

            <!-- Assign Products Card (Manual Only) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="manualProductsBox">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Assign Products</h6>
                        <span class="badge bg-light text-dark border rounded-pill">0 Selected</span>
                    </div>
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-0 shadow-none" placeholder="Search products to add...">
                        </div>
                    </div>
                    <div class="border rounded bg-light p-3 text-center text-muted" style="border-style: dashed !important;">
                        <i class="bi bi-box-seam fs-3 mb-2 d-block opacity-50"></i>
                        <p class="small mb-0">Search and select products to add them to this collection.</p>
                    </div>
                </div>
            </div>

            <!-- SEO Card Partial -->
            <partial name="_SeoCard" model="@("collections")" />
        </div>

        <!-- Right Column: Media -->
        <div class="col-lg-4">
            <!-- Publishing -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Publishing</h6>
                    <label class="form-label fw-semibold small">Status</label>
                    <select class="form-select bg-light border-0 mb-2">
                        <option value="Active">Active</option>
                        <option value="Draft">Draft</option>
                    </select>
                </div>
            </div>

            <!-- Media Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Collection Image</h6>
                    <label class="border-2 border-dashed rounded-4 p-4 text-center d-block" style="background-color: #f8f9fa; border-color: #dee2e6; cursor: pointer; transition: all 0.2s;" onmouseover="this.classList.add('border-primary')" onmouseout="this.classList.remove('border-primary')">
                        <i class="bi bi-image fs-2 text-primary mb-2"></i>
                        <h6 class="fw-semibold mb-1">Add Image</h6>
                        <p class="text-muted small mb-0">Drag and drop here</p>
                        <input type="file" class="d-none" accept="image/*">
                    </label>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const manualRadio = document.getElementById('typeManual');
        const autoRadio = document.getElementById('typeAutomated');
        const conditionsBox = document.getElementById('automatedConditionsBox');
        const manualProductsBox = document.getElementById('manualProductsBox');

        // Toggle condition box / manual product assign box
        manualRadio.addEventListener('change', () => {
            if(manualRadio.checked) {
                conditionsBox.classList.add('d-none');
                manualProductsBox.classList.remove('d-none');
            }
        });
        autoRadio.addEventListener('change', () => {
            if(autoRadio.checked) {
                conditionsBox.classList.remove('d-none');
                manualProductsBox.classList.add('d-none');
            }
        });

        // Toggle Rich Text Toolbar
        const toggleRichText = document.getElementById('toggleRichText');
        const richTextToolbar = document.getElementById('richTextToolbar');
        toggleRichText.addEventListener('change', (e) => {
            if(e.target.checked) {
                richTextToolbar.classList.remove('d-none');
            } else {
                richTextToolbar.classList.add('d-none');
            }
        });
    });
</script>
