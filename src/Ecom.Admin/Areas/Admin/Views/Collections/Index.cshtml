@{
    ViewData["Title"] = "Collections";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Collections</h2>
        <p class="text-muted mb-0 small">Group your products into curated collections (e.g. Summer Sale, New Arrivals)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create Collection
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0 shadow-none" placeholder="Search collections...">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Collections Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold" style="border-top-left-radius: 1rem;">Collection Title</th>
                        <th class="py-3 text-muted fw-semibold">Products</th>
                        <th class="py-3 text-muted fw-semibold">Collection Type</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold" style="border-top-right-radius: 1rem;">Status</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <!-- Mock Data Row 1 -->
                    <tr style="cursor: pointer;">
                        <td class="ps-4 py-3">
                            <h6 class="mb-0 fw-semibold text-dark">Summer Sale 2026</h6>
                            <small class="text-muted">/collections/summer-sale</small>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">42 Items</span>
                        </td>
                        <td class="py-3">
                            <span class="text-secondary small fw-medium"><i class="bi bi-lightning-charge text-warning me-1"></i>Automated</span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                        </td>
                    </tr>
                    <!-- Mock Data Row 2 -->
                    <tr style="cursor: pointer;">
                        <td class="ps-4 py-3">
                            <h6 class="mb-0 fw-semibold text-dark">Featured Products</h6>
                            <small class="text-muted">/collections/featured</small>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">12 Items</span>
                        </td>
                        <td class="py-3">
                            <span class="text-secondary small fw-medium"><i class="bi bi-hand-index-thumb text-primary me-1"></i>Manual</span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
