@model Ecom.Application.Common.Models.PagedResult<Ecom.Application.Features.Collections.Queries.CollectionDto>

@{
    ViewData["Title"] = "Collections";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Collections</h2>
        <p class="text-muted mb-0 small">Group your products into curated collections (e.g. Summer Sale, New Arrivals)</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-download me-1"></i> Export
        </button>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create Collection
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<form method="get" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="SearchTerm" value="@Context.Request.Query["SearchTerm"]" class="form-control bg-light border-0 shadow-none" placeholder="Search collections...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="Type" class="form-select form-select-sm border-0 bg-light rounded-pill shadow-none" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="Manual" selected="@(Context.Request.Query["Type"] == "Manual")">Manual</option>
                    <option value="Automated" selected="@(Context.Request.Query["Type"] == "Automated")">Automated</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="SortBy" class="form-select form-select-sm border-0 bg-light rounded-pill shadow-none" onchange="this.form.submit()">
                    <option value="">Sort By</option>
                    <option value="name" selected="@(Context.Request.Query["SortBy"] == "name")">Name</option>
                    <option value="created" selected="@(Context.Request.Query["SortBy"] == "created")">Date Created</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-light btn-sm rounded-pill w-100 border text-muted">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </div>
</form>

<!-- Collections Table -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Table Header Toolbar -->
    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input shadow-none" type="checkbox" id="selectAll" style="cursor: pointer;">
            </div>
            <div class="dropdown">
                <button class="btn btn-sm btn-light border text-muted dropdown-toggle rounded-pill px-3" type="button" id="bulkActions" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                    Bulk Actions
                </button>
                <ul class="dropdown-menu shadow border-0" aria-labelledby="bulkActions">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-eye-slash me-2"></i>Hide Selected</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete Selected</a></li>
                </ul>
            </div>
        </div>
        <div class="text-muted small fw-semibold">@Model.TotalCount items total</div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3" style="width: 40px; border-top-left-radius: 1rem;"></th>
                        <th class="py-3 text-muted fw-semibold">Collection</th>
                        <th class="py-3 text-muted fw-semibold">Products</th>
                        <th class="py-3 text-muted fw-semibold">Collection Type</th>
                        <th class="py-3 text-muted fw-semibold">Status</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold" style="border-top-right-radius: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-collection fs-3 d-block mb-3 opacity-50"></i>
                                No collections found. Get started by creating your first collection.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Name" class="rounded object-fit-cover me-3" style="width: 48px; height: 48px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                                <i class="bi bi-collection fs-4 text-primary"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-semibold text-dark">@item.Name</h6>
                                            <small class="text-muted">/collections/@item.Slug</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">@item.ProductsCount Items</span>
                                </td>
                                <td class="py-3">
                                    @if (item.Type == "Automated")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-1">
                                            <i class="bi bi-robot me-1"></i> Automated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1">
                                            <i class="bi bi-hand-index me-1"></i> Manual
                                        </span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-normal">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-normal">
                                            <i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i> Draft
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-slug="@item.Slug"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-collectionId="@item.Id"><i class="bi bi-eye me-2"></i>View Products</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this collection?');">
                                                    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                                        <i class="bi bi-trash me-2"></i>Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-3">
            <partial name="_Pagination" />
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.row-checkbox');
        const bulkActionsBtn = document.getElementById('bulkActions');

        function updateBulkActions() {
            const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
            if(bulkActionsBtn) {
                bulkActionsBtn.disabled = !anyChecked;
                if (anyChecked) {
                    bulkActionsBtn.classList.remove('btn-light', 'text-muted');
                    bulkActionsBtn.classList.add('btn-primary');
                } else {
                    bulkActionsBtn.classList.add('btn-light', 'text-muted');
                    bulkActionsBtn.classList.remove('btn-primary');
                }
            }
        }

        if(selectAll) {
            selectAll.addEventListener('change', function() {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateBulkActions();
            });
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                if(selectAll) selectAll.checked = allChecked;
                updateBulkActions();
            });
        });
    });
</script>

<style>
    .custom-table th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .custom-table tbody tr {
        transition: background-color 0.2s ease;
    }
    .custom-table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .dropdown-toggle::after {
        vertical-align: middle;
    }
</style>
