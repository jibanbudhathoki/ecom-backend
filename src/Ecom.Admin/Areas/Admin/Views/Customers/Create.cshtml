@{
    ViewData["Title"] = ViewData["Action"]?.ToString() == "Edit" ? "Edit Customer" : "Add Customer";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Customers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(ViewData["Action"]?.ToString() == "Edit" ? "Edit" : "Add") Customer</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">@(ViewData["Action"]?.ToString() == "Edit" ? "Edit" : "Add") Customer</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">Cancel</a>
        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">@(ViewData["Action"]?.ToString() == "Edit" ? "Update" : "Save") Customer</button>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h6 class="fw-bold mb-0">Customer Overview</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">First Name</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="e.g. Jane">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Last Name</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="e.g. Doe">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Email Address</label>
                        <input type="email" class="form-control bg-light border-0" placeholder="e.g. jane.doe@example.com">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Phone Number</label>
                        <input type="tel" class="form-control bg-light border-0" placeholder="+1 (555) 000-0000">
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h6 class="fw-bold mb-0">Default Address</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Address</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="Street address or P.O. Box">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Apartment, suite, etc.</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="Apartment, suite, unit, building, floor, etc.">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">City</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="City">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">State/Province</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="State">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">ZIP/Postal Code</label>
                        <input type="text" class="form-control bg-light border-0" placeholder="ZIP Code">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
