@{
    ViewData["Title"] = "Customer Details";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Customers</a></li>
                <li class="breadcrumb-item active" aria-current="page">Jane Doe</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <h2 class="h3 mb-0 text-gray-800 fw-bold">Jane Doe</h2>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2"><i class="bi bi-star-fill me-1"></i> VIP</span>
        </div>
        <p class="text-muted mt-2 mb-0 small">Customer since Oct 2024</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="1" class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-envelope me-1"></i> Send Message
        </button>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <!-- Customer Profile Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 text-center">
                 <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-weight: 600; font-size: 2rem;">
                    JD
                </div>
                <h5 class="fw-bold mb-1">Jane Doe</h5>
                <p class="text-muted mb-3">jane.doe@example.com</p>
                <div class="d-flex justify-content-center gap-2">
                    <span class="badge bg-light text-dark border px-2 py-1">New York, NY</span>
                    <span class="badge bg-success bg-opacity-10 text-success border px-2 py-1">Subscribed</span>
                </div>
            </div>
            <div class="card-footer bg-white border-top p-4">
                <h6 class="fw-bold mb-3">Default Address</h6>
                <p class="mb-1 text-secondary">Jane Doe</p>
                <p class="mb-1 text-secondary">123 Fifth Avenue, Apt 4B</p>
                <p class="mb-1 text-secondary">New York, NY 10003</p>
                <p class="mb-0 text-secondary">United States</p>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <!-- Order History Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Order History (12)</h6>
                <a href="#" class="text-decoration-none small text-primary fw-medium">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-cart3 fs-1 mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0">Order history timeline coming soon.</p>
                </div>
            </div>
        </div>
    </div>
</div>
