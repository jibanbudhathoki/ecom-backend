@{
    ViewData["Title"] = "Customers";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Customers</h2>
        <p class="text-muted mb-0 small">View and manage customer details, purchase history, and segments.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-download me-1"></i> Export
        </button>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Customer
        </a>
    </div>
</div>

<!-- Filters and Analytics Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Total Customers</h6>
                    <h3 class="mb-0 fw-bold">12,492</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-person-plus fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">New (30d)</h6>
                    <h3 class="mb-0 fw-bold">489</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-star fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">VIP Customers</h6>
                    <h3 class="mb-0 fw-bold">850</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-envelope-x fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Unsubscribed</h6>
                    <h3 class="mb-0 fw-bold">34</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0 shadow-none" placeholder="Search customers by name, email, or phone...">
                </div>
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button class="btn btn-sm btn-light border rounded-pill px-3 active-filter">All</button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-muted">Subscribed</button>
                <button class="btn btn-sm btn-light border rounded-pill px-3 text-muted">Repeat Buyers</button>
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-light rounded-pill w-100 border text-muted">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Customers Table -->
<div class="card border-0 shadow-sm rounded-4">
    <!-- Table Header Toolbar -->
    <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input shadow-none" type="checkbox" id="selectAll" style="cursor: pointer;">
            </div>
            <div class="dropdown">
                <button class="btn btn-sm btn-light border text-muted dropdown-toggle rounded-pill px-3" type="button" id="bulkActions" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                    Bulk Actions
                </button>
                <ul class="dropdown-menu shadow border-0" aria-labelledby="bulkActions">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-tags me-2"></i>Add Tags</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-envelope me-2"></i>Email Segments</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete Customers</a></li>
                </ul>
            </div>
        </div>
        <div class="text-muted small fw-semibold">Showing 20 of 12,492 customers</div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3" style="width: 40px; border-top-left-radius: 1rem;"></th>
                        <th class="py-3 text-muted fw-semibold">Customer Name</th>
                        <th class="py-3 text-muted fw-semibold">Location</th>
                        <th class="py-3 text-muted fw-semibold">Orders</th>
                        <th class="py-3 text-muted fw-semibold">Total Spent</th>
                        <th class="py-3 text-muted fw-semibold">Last Order</th>
                        <th class="pe-4 py-3 text-end text-muted fw-semibold" style="border-top-right-radius: 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <!-- Customer 1 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600; font-size: 1.1rem;">
                                    JD
                                </div>
                                <div>
                                    <a asp-action="Details" asp-route-id="1" class="fw-bold text-decoration-none text-dark d-block">Jane Doe</a>
                                    <small class="text-muted">jane.doe@example.com</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary">
                            New York, NY
                        </td>
                        <td class="py-3">
                            12
                        </td>
                        <td class="py-3 fw-medium">
                            $4,290.00
                        </td>
                        <td class="py-3 text-secondary">
                            Oct 4, 2026
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <a asp-action="Details" asp-route-id="1" class="btn btn-sm btn-light rounded-pill px-3 border text-primary fw-medium">View</a>
                        </td>
                    </tr>
                    
                    <!-- Customer 2 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600; font-size: 1.1rem;">
                                    MS
                                </div>
                                <div>
                                    <a asp-action="Details" asp-route-id="2" class="fw-bold text-decoration-none text-dark d-block">Michael Smith</a>
                                    <small class="text-muted">michael.s@example.com</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary">
                            Los Angeles, CA
                        </td>
                        <td class="py-3">
                            1
                        </td>
                        <td class="py-3 fw-medium">
                            $349.50
                        </td>
                        <td class="py-3 text-secondary">
                            Oct 3, 2026
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <a asp-action="Details" asp-route-id="2" class="btn btn-sm btn-light rounded-pill px-3 border text-primary fw-medium">View</a>
                        </td>
                    </tr>

                    <!-- Customer 3 -->
                    <tr>
                        <td class="ps-4 py-3">
                            <input class="form-check-input shadow-none row-checkbox" type="checkbox" style="cursor: pointer;">
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600; font-size: 1.1rem;">
                                    EL
                                </div>
                                <div>
                                    <a asp-action="Details" asp-route-id="3" class="fw-bold text-decoration-none text-dark d-block">Emma Larson</a>
                                    <small class="text-muted">emma.l@example.com</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 text-secondary">
                            Chicago, IL
                        </td>
                        <td class="py-3">
                            3
                        </td>
                        <td class="py-3 fw-medium">
                            $890.99
                        </td>
                        <td class="py-3 text-secondary">
                            Sep 28, 2026
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <a asp-action="Details" asp-route-id="3" class="btn btn-sm btn-light rounded-pill px-3 border text-primary fw-medium">View</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Pagination -->
    <div class="card-footer bg-white border-top py-3 d-flex justify-content-center" style="border-bottom-left-radius: 1rem; border-bottom-right-radius: 1rem;">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0 gap-2">
                <li class="page-item disabled">
                    <a class="page-link rounded-circle border-0 text-muted" href="#" tabindex="-1" aria-disabled="true"><i class="bi bi-chevron-left"></i></a>
                </li>
                <li class="page-item active"><a class="page-link rounded-circle border-0 shadow-sm" href="#">1</a></li>
                <li class="page-item"><a class="page-link rounded-circle border-0 text-muted" href="#">2</a></li>
                <li class="page-item"><a class="page-link rounded-circle border-0 text-muted" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link rounded-circle border-0 text-muted" href="#"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.row-checkbox');
        const bulkActionsBtn = document.getElementById('bulkActions');

        function updateBulkActions() {
            const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
            bulkActionsBtn.disabled = !anyChecked;
            if (anyChecked) {
                bulkActionsBtn.classList.remove('btn-light', 'text-muted');
                bulkActionsBtn.classList.add('btn-primary');
            } else {
                bulkActionsBtn.classList.add('btn-light', 'text-muted');
                bulkActionsBtn.classList.remove('btn-primary');
            }
        }

        if(selectAll) {
            selectAll.addEventListener('change', function() {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateBulkActions();
            });
        }

        checkboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                const allChecked = Array.from(checkboxes).every(c => c.checked);
                if(selectAll) selectAll.checked = allChecked;
                updateBulkActions();
            });
        });
    });
</script>

<style>
    .custom-table th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .custom-table tbody tr {
        transition: background-color 0.2s ease;
    }
    .custom-table tbody tr:hover {
        background-color: #f8f9fa;
    }
    .active-filter {
        background-color: #e9ecef !important;
        font-weight: 600;
        color: #495057 !important;
    }
    .page-link {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .page-item.active .page-link {
        background-color: #0d6efd;
        color: white;
    }
</style>
