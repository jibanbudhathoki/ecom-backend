@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="fw-bold mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, here's what's happening with your store today.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light border shadow-sm"><i class="bi bi-calendar3 me-2"></i> Last 30 Days</button>
        <button class="btn btn-primary shadow-sm"><i class="bi bi-download me-2"></i> Export Report</button>
    </div>
</div>

<!-- KPI Cards Row -->
<div class="row g-4 mb-4">
    <!-- Total Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up me-1"></i>12.5%</span>
                </div>
                <h6 class="text-muted fw-semibold mb-1">Total Revenue</h6>
                <h3 class="fw-bold mb-0">$45,231.89</h3>
            </div>
        </div>
    </div>
    
    <!-- Total Orders -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-cart-check fs-4"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up me-1"></i>8.2%</span>
                </div>
                <h6 class="text-muted fw-semibold mb-1">Total Orders</h6>
                <h3 class="fw-bold mb-0">1,245</h3>
            </div>
        </div>
    </div>
    
    <!-- New Customers -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1"><i class="bi bi-arrow-down me-1"></i>2.4%</span>
                </div>
                <h6 class="text-muted fw-semibold mb-1">New Customers</h6>
                <h3 class="fw-bold mb-0">384</h3>
            </div>
        </div>
    </div>
    
    <!-- Conversion Rate -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-activity fs-4"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up me-1"></i>4.1%</span>
                </div>
                <h6 class="text-muted fw-semibold mb-1">Conversion Rate</h6>
                <h3 class="fw-bold mb-0">3.8%</h3>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row g-4">
    <!-- Charts Area (Left) -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Revenue Overview</h5>
                <button class="btn btn-sm btn-light"><i class="bi bi-three-dots"></i></button>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                <!-- Placeholder for Chart.js -->
                <div class="text-center text-muted">
                    <i class="bi bi-bar-chart fs-1 mb-2"></i>
                    <p class="mb-0">Chart.js implementation goes here</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Products (Right) -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold mb-0">Top Products</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-light rounded p-2 me-3">
                        <i class="bi bi-laptop text-primary fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-0 fw-semibold">MacBook Pro 16"</h6>
                        <small class="text-muted">84 sales</small>
                    </div>
                    <div class="fw-bold">$124K</div>
                </div>
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-light rounded p-2 me-3">
                        <i class="bi bi-phone text-info fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-0 fw-semibold">iPhone 15 Pro</h6>
                        <small class="text-muted">62 sales</small>
                    </div>
                    <div class="fw-bold">$74K</div>
                </div>
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded p-2 me-3">
                        <i class="bi bi-smartwatch text-warning fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-0 fw-semibold">Apple Watch Ultra</h6>
                        <small class="text-muted">45 sales</small>
                    </div>
                    <div class="fw-bold">$35K</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="row mt-2">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Orders</h5>
                <a href="#" class="text-decoration-none fw-semibold">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="fw-semibold px-4 py-3 border-0">ORDER ID</th>
                                <th class="fw-semibold py-3 border-0">CUSTOMER</th>
                                <th class="fw-semibold py-3 border-0">DATE</th>
                                <th class="fw-semibold py-3 border-0">AMOUNT</th>
                                <th class="fw-semibold py-3 border-0">STATUS</th>
                                <th class="fw-semibold text-end px-4 py-3 border-0">ACTION</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            <tr>
                                <td class="px-4 py-3"><span class="fw-semibold text-primary">#ORD-001</span></td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">JS</div>
                                        <span class="fw-medium">John Smith</span>
                                    </div>
                                </td>
                                <td class="py-3 text-muted">Oct 24, 2024</td>
                                <td class="py-3 fw-semibold">$1,299.00</td>
                                <td class="py-3"><span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Completed</span></td>
                                <td class="text-end px-4 py-3">
                                    <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3"><span class="fw-semibold text-primary">#ORD-002</span></td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">EM</div>
                                        <span class="fw-medium">Emma Watson</span>
                                    </div>
                                </td>
                                <td class="py-3 text-muted">Oct 24, 2024</td>
                                <td class="py-3 fw-semibold">$45.50</td>
                                <td class="py-3"><span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Pending</span></td>
                                <td class="text-end px-4 py-3">
                                    <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3"><span class="fw-semibold text-primary">#ORD-003</span></td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">MJ</div>
                                        <span class="fw-medium">Michael Jordan</span>
                                    </div>
                                </td>
                                <td class="py-3 text-muted">Oct 23, 2024</td>
                                <td class="py-3 fw-semibold">$899.99</td>
                                <td class="py-3"><span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Processing</span></td>
                                <td class="text-end px-4 py-3">
                                    <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 border-bottom-0"><span class="fw-semibold text-primary">#ORD-004</span></td>
                                <td class="py-3 border-bottom-0">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">DR</div>
                                        <span class="fw-medium">Daniel Radcliffe</span>
                                    </div>
                                </td>
                                <td class="py-3 text-muted border-bottom-0">Oct 23, 2024</td>
                                <td class="py-3 fw-semibold border-bottom-0">$120.00</td>
                                <td class="py-3 border-bottom-0"><span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Cancelled</span></td>
                                <td class="text-end px-4 py-3 border-bottom-0">
                                    <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
