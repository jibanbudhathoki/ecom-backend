                    <button class="btn btn-sm btn-light border rounded-pill shadow-none fw-medium text-dark">Rename</button>
                    <button class="btn btn-sm btn-primary rounded-pill shadow-none fw-medium" onclick="showSaveToast()"><i class="bi bi-check2 me-1"></i> Save Links</button>
                </div>
            </div>
            
            <div class="card-body p-4 bg-light">
                <div class="d-flex justify-content-between mb-3">
                    <p class="text-muted small mb-0">Drag and drop to reorder. You can also nest links to create dropdown menus.</p>
                </div>

                <div id="navigationBuilderFooter" class="d-flex flex-column gap-2 mb-4 sortable-root">
                    
                    <!-- Link 1 -->
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <i class="bi bi-grip-vertical text-muted drag-handle fs-5"></i>
                                <div class="row g-2 flex-grow-1 align-items-center">
                                    <div class="col-md-5">
                                        <input type="text" class="form-control form-control-sm shadow-none" value="Support">
                                    </div>
                                    <div class="col-md-7">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                            <input type="text" class="form-control shadow-none border-start-0" value="/pages/support">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ms-3 flex-shrink-0">
                                <button class="btn btn-sm btn-light rounded-circle text-danger shadow-none"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Link 2 -->
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <i class="bi bi-grip-vertical text-muted drag-handle fs-5"></i>
                                <div class="row g-2 flex-grow-1 align-items-center">
                                    <div class="col-md-5">
                                        <input type="text" class="form-control form-control-sm shadow-none" value="FAQ">
                                    </div>
                                    <div class="col-md-7">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                            <input type="text" class="form-control shadow-none border-start-0" value="/pages/faq">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ms-3 flex-shrink-0">
                                <button class="btn btn-sm btn-light rounded-circle text-danger shadow-none"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>

                </div>
                <button class="btn btn-outline-primary border-dashed rounded-3 w-100 py-3 fw-medium shadow-none"><i class="bi bi-plus-circle me-2"></i>Add New Link</button>
            </div>
        </div>



        <!-- Editor: Top Links -->
