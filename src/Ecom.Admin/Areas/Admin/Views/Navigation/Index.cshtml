@{
    ViewData["Title"] = "Navigation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Navigation</h2>
        <p class="text-muted mb-0 small">Manage your store's menus and links.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Menu List -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 rounded-top-4 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Menus</h6>
                <button class="btn btn-sm btn-outline-primary shadow-none rounded-pill fw-medium"><i class="bi bi-plus-lg me-1"></i> Add Menu</button>
            </div>
            <div class="list-group list-group-flush rounded-bottom-4" id="menuList">
                <button class="list-group-item list-group-item-action p-4 border-bottom active" onclick="switchMenu('main', this)">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <h6 class="mb-1 fw-bold menu-title">Main Menu</h6>
                        <small>5 items</small>
                    </div>
                    <p class="mb-0 small opacity-75">Used in header</p>
                </button>
                <button class="list-group-item list-group-item-action p-4 border-bottom" onclick="switchMenu('footer', this)">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <h6 class="mb-1 fw-bold text-dark menu-title">Footer Menu</h6>
                        <small class="text-muted">3 items</small>
                    </div>
                    <p class="mb-0 small text-muted">Used in footer</p>
                </button>
                <button class="list-group-item list-group-item-action p-4 border-bottom" onclick="switchMenu('top', this)">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <h6 class="mb-1 fw-bold text-dark menu-title">Top Menu</h6>
                        <small class="text-muted">2 items</small>
                    </div>
                    <p class="mb-0 small text-muted">Used in top bar</p>
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Menu Editor -->
    <div class="col-md-8">
        
        <!-- Editor: Main Menu -->
        <div class="card border-0 shadow-sm rounded-4 menu-editor" id="editor-main">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 rounded-top-4 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Main Menu Links</h6>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-danger rounded-pill shadow-none fw-medium"><i class="bi bi-trash"></i></button>
                    <button class="btn btn-sm btn-light border rounded-pill shadow-none fw-medium text-dark">Rename</button>
                    <button class="btn btn-sm btn-primary rounded-pill shadow-none fw-medium" onclick="showSaveToast()"><i class="bi bi-check2 me-1"></i> Save Links</button>
                </div>
            </div>
            
            <div class="card-body p-4 bg-light">
                <div class="d-flex justify-content-between mb-3">
                    <p class="text-muted small mb-0">Drag and drop to reorder. You can also nest links to create dropdown menus.</p>
                </div>

                <div id="navigationBuilderMain" class="d-flex flex-column gap-2 mb-4 sortable-root">
                    
                    <!-- Link 1 -->
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <i class="bi bi-grip-vertical text-muted drag-handle fs-5"></i>
                                <div class="row g-2 flex-grow-1 align-items-center">
                                    <div class="col-md-5">
                                        <input type="text" class="form-control form-control-sm shadow-none" value="Home">
                                    </div>
                                    <div class="col-md-7">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                            <input type="text" class="form-control shadow-none border-start-0" value="/">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ms-3 flex-shrink-0">
                                <button class="btn btn-sm btn-light rounded-circle text-danger shadow-none" title="Remove Link"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>

                    <!-- Link 2 with Sub-links -->
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-3 w-100">
                                    <i class="bi bi-grip-vertical text-muted drag-handle fs-5"></i>
                                    <div class="row g-2 flex-grow-1 align-items-center">
                                        <div class="col-md-5">
                                            <input type="text" class="form-control form-control-sm shadow-none" value="Shop">
                                        </div>
                                        <div class="col-md-7">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                                <input type="text" class="form-control shadow-none border-start-0" value="/collections/all">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ms-3 flex-shrink-0">
                                    <button class="btn btn-sm btn-light rounded-circle text-danger shadow-none" title="Remove Link"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                            
