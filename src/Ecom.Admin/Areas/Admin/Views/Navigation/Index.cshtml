                                <div class="card border-0 bg-light rounded-3 mb-2">
                                    <div class="card-body p-2 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2 w-100">
                                            <i class="bi bi-grip-vertical text-muted drag-handle"></i>
                                            <div class="row g-2 flex-grow-1">
                                                <div class="col-md-5">
                                                    <input type="text" class="form-control form-control-sm shadow-none bg-white" value="Electronics">
                                                </div>
                                                <div class="col-md-7">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                                        <input type="text" class="form-control shadow-none border-start-0 bg-white" value="/collections/electronics">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="ms-2 flex-shrink-0">
                                            <button class="btn btn-sm btn-link text-danger shadow-none p-0"><i class="bi bi-x-circle"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card border-0 bg-light rounded-3 mb-2">
                                    <div class="card-body p-2 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2 w-100">
                                            <i class="bi bi-grip-vertical text-muted drag-handle"></i>
                                            <div class="row g-2 flex-grow-1">
                                                <div class="col-md-5">
                                                    <input type="text" class="form-control form-control-sm shadow-none bg-white" value="Fashion">
                                                </div>
                                                <div class="col-md-7">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-link-45deg"></i></span>
                                                        <input type="text" class="form-control shadow-none border-start-0 bg-white" value="/collections/fashion">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="ms-2 flex-shrink-0">
                                            <button class="btn btn-sm btn-link text-danger shadow-none p-0"><i class="bi bi-x-circle"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ms-4 ps-3 mt-2">
                                <button class="btn btn-sm btn-link text-primary text-decoration-none p-0 small fw-medium"><i class="bi bi-plus"></i> Add Sub-link</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <button class="btn btn-outline-primary border-dashed rounded-3 w-100 py-3 fw-medium shadow-none"><i class="bi bi-plus-circle me-2"></i>Add New Link</button>
            </div>
        </div>

        <!-- Editor: Footer Menu -->
