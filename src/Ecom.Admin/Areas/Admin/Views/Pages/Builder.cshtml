@{
    ViewData["Title"] = "Home Page Builder";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Home Page Builder</h2>
        <p class="text-muted mb-0 small">Design your storefront home page by adding and arranging content blocks.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-eye me-1"></i> Preview
        </button>
        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" onclick="showSaveToast()">
            <i class="bi bi-check2 me-1"></i> Save Layout
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Builder Area -->
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold">Active Blocks</h5>
            <span class="badge bg-primary rounded-pill" id="blockCountBadge">4 Blocks</span>
        </div>

        <div class="accordion custom-builder-accordion" id="homePageBuilder">
            
            <!-- Block 1: Hero Slider -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 p-0" id="headingOne">
                    <div class="d-flex align-items-center justify-content-between p-3 cursor-pointer" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-grip-vertical text-muted fs-5 drag-handle"></i>
                            <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-images fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Hero Slider</h6>
                                <p class="text-muted small mb-0">Main banner at the top of the page</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0" onclick="event.stopPropagation();">
                                <input class="form-check-input shadow-none" type="checkbox" role="switch" checked>
                            </div>
                            <button class="btn btn-sm btn-light rounded-circle shadow-none text-danger" onclick="event.stopPropagation(); this.closest('.card').remove(); updateBlockCount();"><i class="bi bi-trash"></i></button>
                            <i class="bi bi-chevron-down text-muted ms-2 transition-transform"></i>
                        </div>
                    </div>
                </div>
                <div id="collapseOne" class="collapse show border-top" aria-labelledby="headingOne" data-bs-parent="#homePageBuilder">
                    <div class="card-body bg-light p-4">
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-dark">Slides</label>
                            <!-- Slide 1 -->
                            <div class="card border mb-3 rounded-3 shadow-none bg-white">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h6 class="fw-bold small mb-0">Slide 1</h6>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-circle"></i></button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="border border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center text-muted bg-light" style="height: 120px; cursor: pointer;">
                                                <i class="bi bi-cloud-arrow-up fs-3 mb-1"></i>
                                                <span class="small fw-medium">Upload Image</span>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm shadow-none" value="New Summer Collection">
                                            </div>
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm shadow-none" value="Discover the latest trends for this season.">
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <input type="text" class="form-control form-control-sm shadow-none" value="Shop Now">
                                                </div>
                                                <div class="col-6">
                                                    <input type="text" class="form-control form-control-sm shadow-none" value="/collections/summer">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Slide 2 -->
                            <div class="card border mb-3 rounded-3 shadow-none bg-white">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h6 class="fw-bold small mb-0">Slide 2</h6>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-circle"></i></button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="border border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center text-muted bg-light" style="height: 120px; cursor: pointer;">
                                                <i class="bi bi-cloud-arrow-up fs-3 mb-1"></i>
                                                <span class="small fw-medium">Upload Image</span>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm shadow-none" value="Exclusive Winter Preview">
                                            </div>
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm shadow-none" value="Get early access to our upcoming winter styles.">
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <input type="text" class="form-control form-control-sm shadow-none" value="View Collection">
                                                </div>
                                                <div class="col-6">
                                                    <input type="text" class="form-control form-control-sm shadow-none" value="/collections/winter-preview">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <button class="btn btn-sm btn-outline-primary rounded-pill fw-medium"><i class="bi bi-plus-lg me-1"></i> Add Slide</button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Slider Height</label>
                                <select class="form-select form-select-sm shadow-none">
                                    <option>Small</option>
                                    <option selected>Medium</option>
                                    <option>Large</option>
                                    <option>Full Screen</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Auto-play Speed</label>
                                <select class="form-select form-select-sm shadow-none">
                                    <option>3 seconds</option>
                                    <option selected>5 seconds</option>
                                    <option>7 seconds</option>
                                    <option>Disable Auto-play</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Block 2: Content Grid (Categories/Collections) -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 p-0" id="headingTwo">
                    <div class="d-flex align-items-center justify-content-between p-3 cursor-pointer collapsed" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-grip-vertical text-muted fs-5 drag-handle"></i>
                            <div class="bg-success bg-opacity-10 text-success rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-grid-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Content Grid</h6>
                                <p class="text-muted small mb-0">Grid of selected categories or collections</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0" onclick="event.stopPropagation();">
                                <input class="form-check-input shadow-none" type="checkbox" role="switch" checked>
                            </div>
                            <button class="btn btn-sm btn-light rounded-circle shadow-none text-danger" onclick="event.stopPropagation(); this.closest('.card').remove(); updateBlockCount();"><i class="bi bi-trash"></i></button>
                            <i class="bi bi-chevron-down text-muted ms-2 transition-transform"></i>
                        </div>
                    </div>
                </div>
                <div id="collapseTwo" class="collapse border-top" aria-labelledby="headingTwo" data-bs-parent="#homePageBuilder">
                    <div class="card-body bg-light p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Section Title</label>
                            <input type="text" class="form-control form-control-sm shadow-none" value="Shop by Category">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Grid Content Type</label>
                            <select class="form-select form-select-sm shadow-none" onchange="document.getElementById('grid-categories').classList.toggle('d-none', this.value !== 'categories'); document.getElementById('grid-collections').classList.toggle('d-none', this.value !== 'collections');">
                                <option value="categories" selected>Categories</option>
                                <option value="collections">Collections</option>
                            </select>
                        </div>
                        <div class="mb-3" id="grid-categories">
                            <label class="form-label small fw-semibold text-dark">Select Multiple Categories</label>
                            <div class="border rounded-3 p-3 bg-white" style="max-height: 150px; overflow-y: auto;">
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="cat1" checked>
                                    <label class="form-check-label small" for="cat1">Electronics</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="cat2" checked>
                                    <label class="form-check-label small" for="cat2">Fashion</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="cat3" checked>
                                    <label class="form-check-label small" for="cat3">Home & Garden</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="cat4">
                                    <label class="form-check-label small" for="cat4">Sports</label>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input shadow-none" type="checkbox" id="cat5">
                                    <label class="form-check-label small" for="cat5">Toys</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3 d-none" id="grid-collections">
                            <label class="form-label small fw-semibold text-dark">Select Multiple Collections</label>
                            <div class="border rounded-3 p-3 bg-white" style="max-height: 150px; overflow-y: auto;">
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="col1" checked>
                                    <label class="form-check-label small" for="col1">Summer Sale</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="col2" checked>
                                    <label class="form-check-label small" for="col2">Winter Clearance</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="col3" checked>
                                    <label class="form-check-label small" for="col3">New Arrivals</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input shadow-none" type="checkbox" id="col4">
                                    <label class="form-check-label small" for="col4">Trending Now</label>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input shadow-none" type="checkbox" id="col5">
                                    <label class="form-check-label small" for="col5">Gifts under $50</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Block 3: Best Sellers (Products) -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 p-0" id="headingThree">
                    <div class="d-flex align-items-center justify-content-between p-3 cursor-pointer collapsed" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-grip-vertical text-muted fs-5 drag-handle"></i>
                            <div class="bg-warning bg-opacity-10 text-warning rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-star-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Product Grid</h6>
                                <p class="text-muted small mb-0">Show products from a specific collection</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0" onclick="event.stopPropagation();">
                                <input class="form-check-input shadow-none" type="checkbox" role="switch" checked>
                            </div>
                            <button class="btn btn-sm btn-light rounded-circle shadow-none text-danger" onclick="event.stopPropagation(); this.closest('.card').remove(); updateBlockCount();"><i class="bi bi-trash"></i></button>
                            <i class="bi bi-chevron-down text-muted ms-2 transition-transform"></i>
                        </div>
                    </div>
                </div>
                <div id="collapseThree" class="collapse border-top" aria-labelledby="headingThree" data-bs-parent="#homePageBuilder">
                    <div class="card-body bg-light p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Section Title</label>
                            <input type="text" class="form-control form-control-sm shadow-none" value="Best Sellers">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Data Source Type</label>
                            <select class="form-select form-select-sm shadow-none" onchange="document.getElementById('ds-collection').classList.toggle('d-none', this.value !== 'collection'); document.getElementById('ds-category').classList.toggle('d-none', this.value !== 'category'); document.getElementById('ds-custom').classList.toggle('d-none', this.value !== 'custom'); document.getElementById('ds-max').classList.toggle('d-none', this.value === 'custom');">
                                <option value="collection" selected>Specific Collection</option>
                                <option value="category">Specific Category</option>
                                <option value="custom">Custom Selected Products</option>
                            </select>
                        </div>
                        
                        <div class="mb-3" id="ds-collection">
                            <label class="form-label small fw-semibold text-dark">Select Collection</label>
                            <select class="form-select form-select-sm shadow-none">
                                <option>New Arrivals</option>
                                <option selected>Best Sellers</option>
                                <option>Trending Now</option>
                                <option>On Sale</option>
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="ds-category">
                            <label class="form-label small fw-semibold text-dark">Select Category</label>
                            <select class="form-select form-select-sm shadow-none">
                                <option>Electronics</option>
                                <option>Fashion</option>
                                <option>Home & Garden</option>
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="ds-custom">
                            <label class="form-label small fw-semibold text-dark">Selected Products</label>
                            <div class="border rounded-3 bg-white">
                                <div class="p-2 border-bottom">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control border-0 bg-light shadow-none" placeholder="Search products to add...">
                                    </div>
                                </div>
                                <div class="p-2" style="max-height: 200px; overflow-y: auto;">
                                    <!-- Product 1 -->
                                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded border bg-light">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-white border rounded d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                                <img src="https://placehold.co/40x40?text=WE" alt="Product" class="img-fluid rounded">
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="small fw-bold text-dark lh-sm">Wireless Earbuds Pro</span>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-normal" style="font-size: 0.65rem;">Electronics</span>
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border fw-normal" style="font-size: 0.65rem;">SKU: EAR-PRO-01</span>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    <!-- Product 2 -->
                                    <div class="d-flex justify-content-between align-items-center p-2 rounded border bg-light">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-white border rounded d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                                                <img src="https://placehold.co/40x40?text=GL" alt="Product" class="img-fluid rounded">
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="small fw-bold text-dark lh-sm">Gaming Laptop X</span>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-normal" style="font-size: 0.65rem;">Computers</span>
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border fw-normal" style="font-size: 0.65rem;">SKU: GL-X-2024</span>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-0" id="ds-max">
                            <label class="form-label small fw-semibold text-dark">Maximum Products</label>
                            <input type="number" class="form-control form-control-sm shadow-none" value="8" style="max-width: 150px;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Block 4: Promotional Banners -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 p-0" id="headingFour">
                    <div class="d-flex align-items-center justify-content-between p-3 cursor-pointer collapsed" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-grip-vertical text-muted fs-5 drag-handle"></i>
                            <div class="bg-info bg-opacity-10 text-info rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-megaphone-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Promotional Banners</h6>
                                <p class="text-muted small mb-0">Grid of custom promotional images</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch m-0" onclick="event.stopPropagation();">
                                <input class="form-check-input shadow-none" type="checkbox" role="switch" checked>
                            </div>
                            <button class="btn btn-sm btn-light rounded-circle shadow-none text-danger" onclick="event.stopPropagation(); this.closest('.card').remove(); updateBlockCount();"><i class="bi bi-trash"></i></button>
                            <i class="bi bi-chevron-down text-muted ms-2 transition-transform"></i>
                        </div>
                    </div>
                </div>
                <div id="collapseFour" class="collapse border-top" aria-labelledby="headingFour" data-bs-parent="#homePageBuilder">
                    <div class="card-body bg-light p-4">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Desktop Layout</label>
                                <select class="form-select form-select-sm shadow-none">
                                    <option>1 Column (Full Width)</option>
                                    <option selected>2 Columns (50/50)</option>
                                    <option>3 Columns</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Mobile Layout</label>
                                <select class="form-select form-select-sm shadow-none">
                                    <option selected>1 Column (Stacked)</option>
                                    <option>2 Columns</option>
                                    <option>Horizontal Scroll (Swipe)</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-dark">Banners</label>
                            
                            <!-- Banner 1 -->
                            <div class="card border mb-3 rounded-3 shadow-none bg-white">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-grip-vertical text-muted drag-handle"></i>
                                            <h6 class="fw-bold small mb-0">Banner 1</h6>
                                        </div>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-circle"></i></button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="border border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center text-muted bg-light" style="height: 100px; cursor: pointer;">
                                                <i class="bi bi-cloud-arrow-up fs-4 mb-1"></i>
                                                <span class="small" style="font-size: 0.75rem;">Upload Image</span>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="mb-2">
                                                <input type="text" class="form-control form-control-sm shadow-none" placeholder="Link URL (e.g. /sale)" value="/collections/mens-sale">
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <input type="text" class="form-control form-control-sm shadow-none" placeholder="Alt Text" value="Summer Mens Sale">
                                                </div>
                                                <div class="col-6">
                                                    <div class="form-check form-switch mt-1">
                                                        <input class="form-check-input" type="checkbox" id="openNewTab1">
                                                        <label class="form-check-label small text-muted" for="openNewTab1">Open in new tab</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Banner 2 -->
                            <div class="card border mb-3 rounded-3 shadow-none bg-white">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-grip-vertical text-muted drag-handle"></i>
                                            <h6 class="fw-bold small mb-0">Banner 2</h6>
                                        </div>
                                        <button class="btn btn-sm text-danger p-0 shadow-none"><i class="bi bi-x-circle"></i></button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="border border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center text-muted bg-light" style="height: 100px; cursor: pointer;">
                                                <i class="bi bi-cloud-arrow-up fs-4 mb-1"></i>
                                                <span class="small" style="font-size: 0.75rem;">Upload Image</span>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="mb-2">
