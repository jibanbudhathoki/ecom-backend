<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var el = document.getElementById('homePageBuilder');
        new Sortable(el, {
            handle: '.drag-handle',
            animation: 150,
            ghostClass: 'bg-light'
        });
    });

    function showSaveToast() {
        const toast = new bootstrap.Toast(document.getElementById('saveToast'));
        toast.show();
    }
    
    function updateBlockCount() {
        const count = document.querySelectorAll('#homePageBuilder > .card').length;
        document.getElementById('blockCountBadge').innerText = count + ' Blocks';
    }

    function addBlock(templateId) {
        const template = document.getElementById(templateId);
        if (!template) return;
        
        // Clone the template content
        const clone = template.content.cloneNode(true);
        
        // Generate unique IDs so Bootstrap collapse works correctly
        const uniqueId = Date.now();
        const cardHeader = clone.querySelector('.card-header');
        const collapseDiv = clone.querySelector('.collapse');
        const toggleBtn = clone.querySelector('[data-bs-toggle="collapse"]');
        
        cardHeader.id = 'heading_' + uniqueId;
        collapseDiv.id = 'collapse_' + uniqueId;
        collapseDiv.setAttribute('aria-labelledby', cardHeader.id);
        toggleBtn.setAttribute('data-bs-target', '#collapse_' + uniqueId);
        toggleBtn.setAttribute('aria-controls', 'collapse_' + uniqueId);
        
        // Append to builder list
        document.getElementById('homePageBuilder').appendChild(clone);
        
        // Update the count and scroll to the bottom
        updateBlockCount();
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }
</script>
