@model Ecom.Application.Features.Products.Commands.CreateProductCommand
@{
    ViewData["Title"] = ViewData["Action"]?.ToString() == "Edit" ? "Edit Product" : "Add Product";
    var categories = ViewBag.Categories as List<Ecom.Application.Features.Categories.Queries.CategoryDto> ?? new();
    var brands = ViewBag.Brands as List<Ecom.Application.Features.Brands.Queries.BrandDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Products</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(ViewData["Action"]?.ToString() == "Edit" ? "Edit" : "Add") Product</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Add New Product</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill shadow-sm text-muted">Discard</a>
        <button type="submit" form="productForm" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-check2 me-1"></i> Save Product
        </button>
    </div>
</div>

<form id="productForm" asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-4">
        <!-- Left Column: Main Details -->
        <div class="col-lg-8">
            <!-- Basic Info Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Basic Information</h6>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold small">Product Title</label>
                        <input asp-for="Name" type="text" class="form-control bg-light border-0" placeholder="e.g. Apple Watch Series 9" required>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fw-semibold small">Slug (URL)</label>
                        <input asp-for="Slug" class="form-control bg-light border-0" placeholder="e.g. apple-watch-series-9" required>
                        <span asp-validation-for="Slug" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Description" class="form-label fw-semibold small mb-0">Description</label>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input shadow-none" type="checkbox" id="toggleRichText">
                                <label class="form-check-label small text-muted" for="toggleRichText">Rich Text</label>
                            </div>
                        </div>
                        <div class="border rounded bg-light overflow-hidden">
                            <!-- WYSIWYG Toolbar -->
                            <div id="richTextToolbar" class="bg-white border-bottom p-2 d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-bold"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-italic"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-type-underline"></i></button>
                                <div class="vr mx-1"></div>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-list-ol"></i></button>
                                <div class="vr mx-1"></div>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-link-45deg"></i></button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0"><i class="bi bi-image"></i></button>
                            </div>
                            <textarea asp-for="Description" class="form-control border-0 bg-light shadow-none" rows="5" placeholder="Detailed product description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-4">

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input shadow-none" type="checkbox" id="enableSpecs" checked style="cursor: pointer;">
                                </div>
                                <label class="form-label fw-semibold small mb-0" for="enableSpecs" style="cursor: pointer;">Technical Specifications</label>
                            </div>
                            <button type="button" id="addSpecBtn" class="btn btn-sm btn-light text-primary fw-medium rounded-pill px-3"><i class="bi bi-plus"></i> Add Spec</button>
                        </div>
                        
                        <div id="specsContainer" class="d-flex flex-column gap-2 ps-4">
                            <!-- Empty Spec Row -->
                            <div class="d-flex gap-2 align-items-center spec-row">
                                <input type="text" class="form-control form-control-sm bg-light border-0 spec-name" placeholder="e.g. Weight" style="flex: 1;">
                                <input type="text" class="form-control form-control-sm bg-light border-0 spec-val" placeholder="e.g. 1.2 kg" style="flex: 2;">
                                <button type="button" class="btn btn-sm text-danger btn-light border-0 remove-row-btn"><i class="bi bi-x"></i></button>
                            </div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-4">

                    <div class="mb-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input shadow-none" type="checkbox" id="enableHighlights" checked style="cursor: pointer;">
                                </div>
                                <label class="form-label fw-semibold small mb-0" for="enableHighlights" style="cursor: pointer;">About this item (Key Highlights)</label>
                            </div>
                            <button type="button" id="addBulletBtn" class="btn btn-sm btn-light text-primary fw-medium rounded-pill px-3"><i class="bi bi-plus"></i> Add Bullet</button>
                        </div>
                        
                        <div id="highlightsContainer" class="d-flex flex-column gap-2">
                            <!-- Empty Highlight Row -->
                            <div class="d-flex gap-2 align-items-start highlight-row">
                                <div class="mt-2"><i class="bi bi-circle-fill text-muted" style="font-size: 0.4rem;"></i></div>
                                <input type="text" class="form-control form-control-sm bg-light border-0 highlight-val" placeholder="Add a key feature or highlight..." style="flex: 1;">
                                <button type="button" class="btn btn-sm text-danger btn-light border-0 remove-row-btn"><i class="bi bi-x"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Media Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Media</h6>
                    
                    <label class="border-2 border-dashed rounded-4 p-4 text-center d-block" style="background-color: #f8f9fa; border-color: #dee2e6; cursor: pointer; transition: all 0.2s;" onmouseover="this.classList.add('border-primary')" onmouseout="this.classList.remove('border-primary')">
                        <i class="bi bi-cloud-arrow-up fs-2 text-primary mb-2"></i>
                        <h6 class="fw-semibold mb-1">Drag and drop images here</h6>
                        <p class="text-muted small mb-3">PNG, JPG, or GIF up to 5MB</p>
                        <span class="btn btn-sm btn-outline-primary rounded-pill px-4">Browse Files</span>
                        <input type="file" name="ImageFiles" class="d-none" multiple accept="image/*">
                    </label>
                </div>
            </div>

            <!-- Pricing Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Pricing</h6>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold small">Price</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-0 rounded-start-pill ps-3">$</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-light border-0 rounded-end-pill shadow-none" placeholder="0.00" required>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OldPrice" class="form-label fw-semibold small">Compare at Price</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-0 rounded-start-pill ps-3">$</span>
                                <input asp-for="OldPrice" type="number" step="0.01" class="form-control bg-light border-0 rounded-end-pill shadow-none" placeholder="0.00">
                            </div>
                            <div class="form-text mt-2" style="font-size: 0.7rem;"><i class="bi bi-info-circle me-1"></i>To show a reduced price, move original price here.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Variants Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input shadow-none" type="checkbox" id="enableVariants" checked style="cursor: pointer;">
                            </div>
                            <h6 class="fw-bold mb-0" style="cursor: pointer;" onclick="document.getElementById('enableVariants').click()">Variants</h6>
                        </div>
                        <a href="javascript:void(0)" id="addVariantRowBtn" class="text-decoration-none small text-primary fw-medium"><i class="bi bi-plus-circle me-1"></i> Add Variant</a>
                    </div>
                    
                    <div class="table-responsive border rounded mt-3" id="variantsContainer">
                        <table class="table table-sm align-middle mb-0" id="variantsTable">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 text-muted small fw-semibold px-3 py-2">Option Type</th>
                                    <th class="border-0 text-muted small fw-semibold py-2">Option Value</th>
                                    <th class="border-0 text-muted small fw-semibold py-2">Images</th>
                                    <th class="border-0 text-muted small fw-semibold py-2">Price</th>
                                    <th class="border-0 text-muted small fw-semibold py-2">Quantity</th>
                                    <th class="border-0 text-muted small fw-semibold py-2">SKU</th>
                                    <th class="border-0 text-muted small fw-semibold py-2 text-end pe-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Variant rows will be appended here -->
                            </tbody>
                        </table>
                        <div id="noVariantsMsg" class="text-center py-4 text-muted small">
                            No variants added. Click "Add Variant" to create one.
                        </div>
                    </div>
                </div>
            </div>

            <!-- SEO Card Partial -->
            <partial name="_SeoCard" model="@("products")" />
        </div>

        <!-- Right Column: Sidebar Settings -->
        <div class="col-lg-4">
            <!-- Status Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Status</h6>
                    <select asp-for="IsActive" class="form-select bg-light border-0 shadow-none mb-3">
                        <option value="true">Active</option>
                        <option value="false">Draft</option>
                    </select>
                    <p class="text-muted small mb-0">This product will be hidden from all sales channels until published.</p>
                </div>
            </div>

            <!-- Organization Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Organization</h6>
                    
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label text-muted small fw-semibold text-uppercase">Category</label>
                        <select asp-for="CategoryId" class="form-select bg-light border-0 shadow-none" required>
                            <option value="">Select Category...</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BrandId" class="form-label text-muted small fw-semibold text-uppercase">Brand</label>
                        <select asp-for="BrandId" class="form-select bg-light border-0 shadow-none">
                            <option value="">Select Brand...</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Inventory Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Inventory</h6>
                    
                    <div class="mb-3">
                        <label asp-for="SKU" class="form-label text-muted small fw-semibold text-uppercase">SKU (Stock Keeping Unit)</label>
                        <input asp-for="SKU" type="text" class="form-control bg-light border-0 shadow-none">
                    </div>

                    <div class="mb-0">
                        <label asp-for="StockQuantity" class="form-label text-muted small fw-semibold text-uppercase">Quantity</label>
                        <input asp-for="StockQuantity" type="number" class="form-control bg-light border-0 shadow-none" value="0">
                        <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle Rich Text Toolbar


        // --- Dynamic Specs & Highlights ---
        const enableSpecs = document.getElementById('enableSpecs');
        const specsContainer = document.getElementById('specsContainer');
        if (enableSpecs && specsContainer) {
            enableSpecs.addEventListener('change', (e) => {
                if (e.target.checked) {
                    specsContainer.classList.remove('d-none');
                    specsContainer.classList.add('d-flex');
                    document.getElementById('addSpecBtn').style.display = 'inline-block';
                } else {
                    specsContainer.classList.remove('d-flex');
                    specsContainer.classList.add('d-none');
                    document.getElementById('addSpecBtn').style.display = 'none';
                }
            });
            enableSpecs.dispatchEvent(new Event('change'));
        }

        const enableHighlights = document.getElementById('enableHighlights');
        const highlightsContainer = document.getElementById('highlightsContainer');
        if (enableHighlights && highlightsContainer) {
            enableHighlights.addEventListener('change', (e) => {
                if (e.target.checked) {
                    highlightsContainer.classList.remove('d-none');
                    highlightsContainer.classList.add('d-flex');
                    document.getElementById('addBulletBtn').style.display = 'inline-block';
                } else {
                    highlightsContainer.classList.remove('d-flex');
                    highlightsContainer.classList.add('d-none');
                    document.getElementById('addBulletBtn').style.display = 'none';
                }
            });
            enableHighlights.dispatchEvent(new Event('change'));
        }
        const addSpecBtn = document.getElementById('addSpecBtn');
        const addBulletBtn = document.getElementById('addBulletBtn');

        if (specsContainer && addSpecBtn) {
            addSpecBtn.addEventListener('click', () => {
                const row = document.createElement('div');
                row.className = 'd-flex gap-2 align-items-center';
                row.innerHTML = `
                    <input type="text" class="form-control form-control-sm bg-light border-0" placeholder="e.g. Memory" style="flex: 1;">
                    <input type="text" class="form-control form-control-sm bg-light border-0" placeholder="e.g. 16GB" style="flex: 2;">
                    <button type="button" class="btn btn-sm text-danger btn-light border-0 remove-row-btn"><i class="bi bi-x"></i></button>
                `;
                specsContainer.appendChild(row);
            });

            specsContainer.addEventListener('click', (e) => {
                const btn = e.target.closest('.remove-row-btn') || e.target.closest('.btn-light');
                if (btn && btn.querySelector('.bi-x')) {
                    btn.closest('.d-flex').remove();
                }
            });
        }

        if (highlightsContainer && addBulletBtn) {
            addBulletBtn.addEventListener('click', () => {
                const row = document.createElement('div');
                row.className = 'd-flex gap-2 align-items-start';
                row.innerHTML = `
                    <div class="mt-2"><i class="bi bi-circle-fill text-muted" style="font-size: 0.4rem;"></i></div>
                    <input type="text" class="form-control form-control-sm bg-light border-0" placeholder="Add a key feature or highlight..." style="flex: 1;">
                    <button type="button" class="btn btn-sm text-danger btn-light border-0 remove-row-btn"><i class="bi bi-x"></i></button>
                `;
                highlightsContainer.appendChild(row);
            });

            highlightsContainer.addEventListener('click', (e) => {
                const btn = e.target.closest('.remove-row-btn') || e.target.closest('.btn-light');
                if (btn && btn.querySelector('.bi-x')) {
                    btn.closest('.d-flex').remove();
                }
            });
        }
        
        // Auto-generate slug from name
        const nameInput = document.getElementById('Name');
        const slugInput = document.getElementById('Slug');
        if (nameInput && slugInput) {
            nameInput.addEventListener('input', function() {
                let name = this.value;
                let slug = name.toLowerCase()
                               .replace(/[^a-z0-9]+/g, '-')
                               .replace(/^-+|-+$/g, '');
                slugInput.value = slug;
            });
        }
        // Index rows before submit
        const form = document.getElementById('productForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                // Specs
                if (document.getElementById('enableSpecs').checked) {
                    const specRows = document.querySelectorAll('.spec-row');
                    let specIndex = 0;
                    specRows.forEach(row => {
                        const nameInput = row.querySelector('.spec-name');
                        const valInput = row.querySelector('.spec-val');
                        if (nameInput.value.trim() !== '') {
                            nameInput.name = `Specifications[${specIndex}].Name`;
                            valInput.name = `Specifications[${specIndex}].Value`;
                            specIndex++;
                        }
                    });
                } else {
                    document.querySelectorAll('.spec-name, .spec-val').forEach(el => el.removeAttribute('name'));
                }
                
                // Highlights
                if (document.getElementById('enableHighlights').checked) {
                    const highlightRows = document.querySelectorAll('.highlight-row');
                    let highlightIndex = 0;
                    highlightRows.forEach(row => {
                        const valInput = row.querySelector('.highlight-val');
                        if (valInput.value.trim() !== '') {
                            valInput.name = `Highlights[${highlightIndex}]`;
                            highlightIndex++;
                        }
                    });
                } else {
                    document.querySelectorAll('.highlight-val').forEach(el => el.removeAttribute('name'));
                }
            });
        }
    });
</script>

<style>
    .border-dashed {
        border-style: dashed !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const addVariantRowBtn = document.getElementById('addVariantRowBtn');
            const variantsTableBody = document.getElementById('variantsTable').querySelector('tbody');
            const noVariantsMsg = document.getElementById('noVariantsMsg');

            let variantRowIndex = 0;

            function updateNoVariantsMsg() {
                if (variantsTableBody.children.length === 0) {
                    noVariantsMsg.classList.remove('d-none');
                } else {
                    noVariantsMsg.classList.add('d-none');
                }
            }

            addVariantRowBtn.addEventListener('click', function() {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="px-3">
                        <input type="text" list="optionTypes" name="Variants[${variantRowIndex}].OptionName" class="form-control form-control-sm bg-light border-0" placeholder="e.g. Color" required>
                        <datalist id="optionTypes">
                            <option value="Color"></option>
                            <option value="Size"></option>
                            <option value="Material"></option>
                            <option value="Style"></option>
                        </datalist>
                        <input type="hidden" name="Variants[${variantRowIndex}].Name" class="variant-name-hidden" value="" />
                        <input type="hidden" name="Variants[${variantRowIndex}].IsActive" value="true" />
                    </td>
                    <td>
                        <input type="text" name="Variants[${variantRowIndex}].OptionValue" class="form-control form-control-sm bg-light border-0 variant-val-input" placeholder="e.g. Red, XL" required>
                    </td>
                    <td>
                        <label class="btn btn-sm btn-light border text-muted d-flex align-items-center justify-content-center gap-2 mb-0" style="cursor: pointer; width: max-content;">
                            <i class="bi bi-image"></i>
                            <span style="font-size: 0.75rem;">Add</span>
                            <input type="file" name="Variants[${variantRowIndex}].ImageFiles" class="d-none" multiple accept="image/*">
                        </label>
                    </td>
                    <td><input type="number" name="Variants[${variantRowIndex}].Price" step="0.01" class="form-control form-control-sm bg-light border-0" placeholder="0.00" style="width: 90px;"></td>
                    <td><input type="number" name="Variants[${variantRowIndex}].StockQuantity" class="form-control form-control-sm bg-light border-0" placeholder="0" style="width: 80px;"></td>
                    <td><input type="text" name="Variants[${variantRowIndex}].SKU" class="form-control form-control-sm bg-light border-0" placeholder="SKU-OPT" style="width: 120px;"></td>
                    <td class="text-end pe-3">
                        <button type="button" class="btn btn-sm btn-light text-danger border-0 remove-variant-btn"><i class="bi bi-trash"></i></button>
                    </td>
                `;
                variantsTableBody.appendChild(tr);
                
                // Keep Name hidden field synced with OptionValue for the backend
                const valInput = tr.querySelector('.variant-val-input');
                const nameHidden = tr.querySelector('.variant-name-hidden');
                valInput.addEventListener('input', (e) => {
                    nameHidden.value = e.target.value;
                });
                
                variantRowIndex++;
                updateNoVariantsMsg();
            });

            // Handle Row Remove
            variantsTableBody.addEventListener('click', function(e) {
                const btn = e.target.closest('.remove-variant-btn');
                if (btn) {
                    btn.closest('tr').remove();
                    updateNoVariantsMsg();
                }
            });
            
            // Handle Toggle Variant feature
            const enableVariants = document.getElementById('enableVariants');
            const variantsContainer = document.getElementById('variantsContainer');
            if (enableVariants && variantsContainer) {
                enableVariants.addEventListener('change', (e) => {
                    variantsContainer.style.display = e.target.checked ? 'block' : 'none';
                    addVariantRowBtn.style.display = e.target.checked ? 'inline-block' : 'none';
                    
                    // If disabling variants, disable inputs so they don't submit to backend
                    const inputs = variantsTableBody.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        input.disabled = !e.target.checked;
                    });
                });
            }
            
            // Add initial empty row by default
            addVariantRowBtn.click();
        });
    </script>
}
