@{
    ViewData["Title"] = "Reviews";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Product Reviews</h2>
        <p class="text-muted mb-0 small">Manage customer reviews and store ratings.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">
            <i class="bi bi-download me-1"></i> Export
        </button>
    </div>
</div>

<!-- Analytics Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-chat-left-text fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Total Reviews</h6>
                    <h3 class="mb-0 fw-bold">1,248</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-star-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Average Rating</h6>
                    <h3 class="mb-0 fw-bold">4.8 <span class="fs-6 text-muted fw-normal">/ 5.0</span></h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Pending Approval</h6>
                    <h3 class="mb-0 fw-bold">12</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted small fw-semibold mb-1">Needs Attention (1-2 Stars)</h6>
                    <h3 class="mb-0 fw-bold">4</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 rounded-top-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <ul class="nav nav-pills custom-nav-pills">
                <li class="nav-item">
                    <a class="nav-link active px-3 py-2 rounded-pill small fw-medium" href="#">All Reviews</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted px-3 py-2 rounded-pill small fw-medium" href="#">Pending <span class="badge bg-danger ms-1 rounded-pill">12</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted px-3 py-2 rounded-pill small fw-medium" href="#">Published</a>
                </li>
            </ul>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-0 rounded-start-pill ps-3"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0 rounded-end-pill shadow-none" placeholder="Search reviews...">
                </div>
                <button class="btn btn-sm btn-light border rounded-pill px-3"><i class="bi bi-funnel"></i></button>
            </div>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 py-3 text-muted small fw-semibold border-bottom-0" style="width: 40px;">
                        <input class="form-check-input shadow-none" type="checkbox">
                    </th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Product & Rating</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Review</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Customer</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Date</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Status</th>
                    <th class="pe-4 py-3 text-end text-muted small fw-semibold border-bottom-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                <!-- Review 1 (Pending) -->
                <tr>
                    <td class="ps-4 py-3"><input class="form-check-input shadow-none" type="checkbox"></td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-headphones text-muted fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 small text-dark">Wireless Earbuds Pro</h6>
                                <div class="text-warning small d-flex gap-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="py-3" style="max-width: 300px;">
                        <h6 class="fw-semibold mb-1 small text-dark">Great sound, average battery</h6>
                        <p class="text-muted small mb-0 text-truncate">The sound quality is amazing, but the battery life could be a little better. Overall happy with the purchase.</p>
                    </td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center small fw-bold" style="width: 32px; height: 32px;">
                                JD
                            </div>
                            <div>
                                <p class="mb-0 small fw-medium text-dark">John Doe</p>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">Verified Buyer</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-muted small">Oct 4, 2026</td>
                    <td class="py-3"><span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 review-status">Pending</span></td>
                    <td class="pe-4 py-3 text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <button class="btn btn-sm btn-outline-success rounded-pill px-3 small fw-medium btn-main-action" onclick="approveReview(this)">Approve</button>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><button class="dropdown-item small" onclick="viewDetails()"><i class="bi bi-eye me-2 text-muted"></i> View Details</button></li>
                                    <li><button class="dropdown-item small text-danger" onclick="deleteRow(this)"><i class="bi bi-x-circle me-2"></i> Reject</button></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
                
                <!-- Review 2 (Published) -->
                <tr>
                    <td class="ps-4 py-3"><input class="form-check-input shadow-none" type="checkbox"></td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-phone text-muted fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 small text-dark">Premium Smartphone</h6>
                                <div class="text-warning small d-flex gap-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="py-3" style="max-width: 300px;">
                        <h6 class="fw-semibold mb-1 small text-dark">Absolutely love it!</h6>
                        <p class="text-muted small mb-0 text-truncate">Best phone I have ever owned. The camera is incredible and the display is super bright.</p>
                    </td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center small fw-bold" style="width: 32px; height: 32px;">
                                AS
                            </div>
                            <div>
                                <p class="mb-0 small fw-medium text-dark">Alice Smith</p>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">Verified Buyer</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-muted small">Oct 3, 2026</td>
                    <td class="py-3"><span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 review-status">Published</span></td>
                    <td class="pe-4 py-3 text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <button class="btn btn-sm btn-light border rounded-pill px-3 small fw-medium btn-main-action" onclick="openReplyModal()">Reply</button>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><button class="dropdown-item small" onclick="viewDetails()"><i class="bi bi-eye me-2 text-muted"></i> View Details</button></li>
                                    <li><button class="dropdown-item small" onclick="unpublishReview(this)"><i class="bi bi-eye-slash me-2 text-muted"></i> Unpublish</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button class="dropdown-item small text-danger" onclick="deleteRow(this)"><i class="bi bi-trash me-2"></i> Delete</button></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>

                <!-- Review 3 (Negative) -->
                <tr>
                    <td class="ps-4 py-3"><input class="form-check-input shadow-none" type="checkbox"></td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-laptop text-muted fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 small text-dark">Gaming Laptop X</h6>
                                <div class="text-warning small d-flex gap-1">
                                    <i class="bi bi-star-fill"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="py-3" style="max-width: 300px;">
                        <h6 class="fw-semibold mb-1 small text-dark">Overheating issues</h6>
                        <p class="text-muted small mb-0 text-truncate">The laptop gets way too hot when playing games. Very disappointed for the price.</p>
                    </td>
                    <td class="py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center small fw-bold" style="width: 32px; height: 32px;">
                                MW
                            </div>
                            <div>
                                <p class="mb-0 small fw-medium text-dark">Mark Wilson</p>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">Guest</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 text-muted small">Oct 2, 2026</td>
                    <td class="py-3"><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 review-status">Action Needed</span></td>
                    <td class="pe-4 py-3 text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <button class="btn btn-sm btn-primary rounded-pill px-3 small fw-medium btn-main-action" onclick="openReplyModal()">Resolve</button>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><button class="dropdown-item small" onclick="viewDetails()"><i class="bi bi-eye me-2 text-muted"></i> View Details</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button class="dropdown-item small text-danger" onclick="deleteRow(this)"><i class="bi bi-trash me-2"></i> Delete</button></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center rounded-bottom-4">
        <span class="text-muted small">Showing 1 to 3 of 1,248 reviews</span>
        <nav aria-label="Reviews pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link shadow-none border-0 text-muted" href="#">Previous</a></li>
                <li class="page-item active"><a class="page-link shadow-none rounded-circle mx-1" href="#" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">1</a></li>
                <li class="page-item"><a class="page-link shadow-none border-0 text-dark" href="#">2</a></li>
                <li class="page-item"><a class="page-link shadow-none border-0 text-dark" href="#">3</a></li>
                <li class="page-item"><a class="page-link shadow-none border-0 text-primary fw-medium" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal: View Details -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Review Details</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-4">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px;">
                        JD
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">John Doe</h6>
                        <p class="mb-0 text-muted small"><i class="bi bi-envelope me-1"></i> john.doe@example.com</p>
                    </div>
                    <div class="ms-auto text-end">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">Published</span>
                        <p class="mb-0 text-muted small mt-1">Oct 4, 2026</p>
                    </div>
                </div>

                <h6 class="fw-bold mb-2">Product</h6>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-headphones text-muted fs-4"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 small fw-medium">Wireless Earbuds Pro</h6>
                        <a href="#" class="small text-decoration-none text-primary">View Product <i class="bi bi-arrow-up-right"></i></a>
                    </div>
                </div>

                <h6 class="fw-bold mb-2">Rating & Review</h6>
                <div class="text-warning mb-2 d-flex gap-1">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                </div>
                <h6 class="fw-bold">Great sound, average battery</h6>
                <p class="text-muted small mb-0">The sound quality is amazing, but the battery life could be a little better. Overall happy with the purchase. The noise cancellation works better than expected in crowded places.</p>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="openReplyModalFromDetails()"><i class="bi bi-reply me-1"></i> Reply to Customer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Reply to Review -->
<div class="modal fade" id="replyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Reply to Customer</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">Your reply will be emailed directly to <strong>John Doe</strong> and posted publicly on the product page.</p>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Your Message</label>
                    <textarea class="form-control rounded-3 shadow-none" rows="5" placeholder="Hi John, thank you for your feedback..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitReply()"><i class="bi bi-send me-1"></i> Send Reply</button>
            </div>
        </div>
    </div>
</div>

<!-- Toasts Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="actionToast" class="toast align-items-center text-white bg-success border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastMessage">
                Action completed successfully.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .custom-nav-pills .nav-link {
        color: #6c757d;
    }
    .custom-nav-pills .nav-link.active {
        background-color: #e9ecef;
        color: #212529;
    }
</style>

@section Scripts {
    <script>
        let viewModal;
        let replyModal;

        document.addEventListener('DOMContentLoaded', function() {
            // Because of our layout sidebar fix, modals might need to be appended to body
            viewModal = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
            replyModal = new bootstrap.Modal(document.getElementById('replyModal'));
            
            document.body.appendChild(document.getElementById('viewDetailsModal'));
            document.body.appendChild(document.getElementById('replyModal'));
        });

        function showToast(message, type = 'success') {
            const toastEl = document.getElementById('actionToast');
            const toastMsg = document.getElementById('toastMessage');
            
            toastEl.classList.remove('bg-success', 'bg-danger', 'bg-warning');
            toastEl.classList.add('bg-' + type);
            
            toastMsg.innerText = message;
            
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function approveReview(btn) {
            const row = btn.closest('tr');
            
            // Update Status Badge
            const badge = row.querySelector('.review-status');
            badge.className = 'badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 review-status';
            badge.innerText = 'Published';

            // Change button to Reply
            btn.className = 'btn btn-sm btn-light border rounded-pill px-3 small fw-medium btn-main-action';
            btn.innerText = 'Reply';
            btn.onclick = function() { openReplyModal(); };

            showToast('Review approved and published!', 'success');
        }

        function unpublishReview(btn) {
            const row = btn.closest('tr');
            
            // Update Status Badge
            const badge = row.querySelector('.review-status');
            badge.className = 'badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 review-status';
            badge.innerText = 'Pending';

            // Change main button back to Approve
            const mainBtn = row.querySelector('.btn-main-action');
            if (mainBtn) {
                mainBtn.className = 'btn btn-sm btn-outline-success rounded-pill px-3 small fw-medium btn-main-action';
                mainBtn.innerText = 'Approve';
                mainBtn.onclick = function() { approveReview(mainBtn); };
            }

            showToast('Review unpublished and moved to pending.', 'warning');
        }

        function deleteRow(btn) {
            const row = btn.closest('tr');
            row.style.transition = "opacity 0.3s";
            row.style.opacity = "0";
            setTimeout(() => {
                row.remove();
                showToast('Review successfully removed.', 'success');
            }, 300);
        }

        function viewDetails() {
            viewModal.show();
        }

        function openReplyModal() {
            replyModal.show();
        }

        function openReplyModalFromDetails() {
            viewModal.hide();
            setTimeout(() => {
                replyModal.show();
            }, 400); // Wait for first modal to close
        }

        function submitReply() {
            replyModal.hide();
            showToast('Reply sent successfully!', 'success');
        }
    </script>
}
