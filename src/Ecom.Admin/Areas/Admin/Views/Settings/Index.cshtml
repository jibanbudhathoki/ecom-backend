<!-- Modals -->

<!-- API Key Generate Modal -->
<div class="modal fade" id="apiKeyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Generate API Key</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Key Name</label>
                    <input type="text" class="form-control bg-light border-0" placeholder="e.g. Warehouse Integration">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Permissions</label>
                    <select class="form-select bg-light border-0">
                        <option>Read Only</option>
                        <option>Read & Write</option>
                    </select>
                </div>
                <button class="btn btn-primary w-100 rounded-pill py-2">Generate Key</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Config Modal -->
<div class="modal fade" id="paymentConfigModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Configure Payment Gateway</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input shadow-none" type="checkbox" id="testMode" checked>
                    <label class="form-check-label text-dark fw-medium small" for="testMode">Enable Test Mode</label>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Merchant ID</label>
                    <input type="text" class="form-control bg-light border-0" value="MERCH_12345">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">API Key</label>
                    <input type="password" class="form-control bg-light border-0" value="apikey_xxxxx">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Secret Key</label>
                    <input type="password" class="form-control bg-light border-0" value="secret_xxxxx">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Webhook URL</label>
                    <input type="text" class="form-control bg-light border-0 text-muted small" value="https://mystore.com/api/webhooks/payment" readonly>
                </div>
                <button class="btn btn-primary w-100 rounded-pill py-2">Save Configuration</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Store Modal -->
<div class="modal fade" id="deleteStoreModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">Delete Store?</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dark fw-medium">This action is permanent.</p>
                <ul class="text-muted small mb-4">
                    <li>Store data will be deleted.</li>
                    <li>Products/orders/customers/settings will be removed.</li>
                    <li>This cannot be undone.</li>
                </ul>
                <div class="mb-4">
                    <label class="form-label fw-semibold small text-danger">Type DELETE to confirm</label>
                    <input type="text" class="form-control border-danger bg-danger bg-opacity-10 text-danger fw-bold" placeholder="">
                </div>
                <button class="btn btn-danger w-100 rounded-pill py-2 shadow-sm" data-bs-dismiss="modal">I Understand, Delete Store</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Notification Toast (Mock) -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
    <div id="saveToast" class="toast align-items-center text-white bg-success border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium">
                <i class="bi bi-check-circle me-2"></i> Settings saved successfully.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto shadow-none" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .custom-v-pills .nav-link {
        color: #495057;
        background-color: transparent;
        transition: all 0.2s ease;
    }
    .custom-v-pills .nav-link:hover {
        background-color: #f8f9fa;
    }
    .custom-v-pills .nav-link.active {
        color: #0d6efd;
        background-color: #e9ecef;
        font-weight: 600;
    }
    @@media (max-width: 768px) {
        .custom-v-pills {
            flex-direction: row !important;
            overflow-x: auto;
            flex-wrap: nowrap;
            padding-bottom: 1rem;
        }
        .custom-v-pills .nav-link {
            white-space: nowrap;
            margin-right: 0.5rem;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Fix modal backdrop issues by moving modals to body
        document.body.appendChild(document.getElementById('apiKeyModal'));
        document.body.appendChild(document.getElementById('paymentConfigModal'));
        document.body.appendChild(document.getElementById('deleteStoreModal'));
        
        // Mock save button
        document.querySelector('.btn-primary').addEventListener('click', function() {
            const toast = new bootstrap.Toast(document.getElementById('saveToast'));
            toast.show();
        });
    });
</script>
