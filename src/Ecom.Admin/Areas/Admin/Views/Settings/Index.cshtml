                                        <div class="col-md-6">
                                            <div class="form-check form-switch d-flex justify-content-between px-0 align-items-center">
                                                <label class="form-check-label text-dark fw-medium small mb-0" for="e_@notif.Replace(" ", "")">@notif</label>
                                                <input class="form-check-input shadow-none m-0" type="checkbox" id="e_@notif.Replace(" ", "")" checked>
                                            </div>
                                            <hr class="text-muted opacity-25 my-2">
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- SMS Content -->
