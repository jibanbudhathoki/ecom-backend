                                    <td class="py-3"><span class="badge bg-success bg-opacity-10 text-success rounded-pill">Active</span></td>
                                    <td class="pe-4 py-3 text-end">
                                        <button class="btn btn-sm btn-light text-primary rounded-pill px-3">Edit</button>
