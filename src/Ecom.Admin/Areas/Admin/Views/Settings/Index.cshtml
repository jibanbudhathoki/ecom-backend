@{
    ViewData["Title"] = "Settings";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Settings</h2>
        <p class="text-muted mb-0 small">Manage your store preferences and configurations.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light px-4 py-2 rounded-pill shadow-sm border text-muted">Cancel</button>
        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">Save Changes</button>
    </div>
</div>

<div class="row align-items-start">
    <!-- Sidebar Navigation -->
    <div class="col-md-3 mb-4">
        <div class="nav flex-column nav-pills custom-v-pills gap-1" id="v-pills-tab" role="tablist" aria-orientation="vertical">
            <button class="nav-link active text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-general-tab" data-bs-toggle="pill" data-bs-target="#v-pills-general" type="button" role="tab" aria-controls="v-pills-general" aria-selected="true">
                <i class="bi bi-gear me-2 opacity-75"></i> General
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-branding-tab" data-bs-toggle="pill" data-bs-target="#v-pills-branding" type="button" role="tab" aria-controls="v-pills-branding" aria-selected="false">
                <i class="bi bi-palette me-2 opacity-75"></i> Branding & Assets
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-payments-tab" data-bs-toggle="pill" data-bs-target="#v-pills-payments" type="button" role="tab" aria-controls="v-pills-payments" aria-selected="false">
                <i class="bi bi-credit-card me-2 opacity-75"></i> Payments
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-shipping-tab" data-bs-toggle="pill" data-bs-target="#v-pills-shipping" type="button" role="tab" aria-controls="v-pills-shipping" aria-selected="false">
                <i class="bi bi-truck me-2 opacity-75"></i> Shipping & Delivery
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-taxes-tab" data-bs-toggle="pill" data-bs-target="#v-pills-taxes" type="button" role="tab" aria-controls="v-pills-taxes" aria-selected="false">
                <i class="bi bi-calculator me-2 opacity-75"></i> Taxes & Duties
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-emailsms-tab" data-bs-toggle="pill" data-bs-target="#v-pills-emailsms" type="button" role="tab" aria-controls="v-pills-emailsms" aria-selected="false">
                <i class="bi bi-envelope-paper me-2 opacity-75"></i> Email & SMS
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-notifications-tab" data-bs-toggle="pill" data-bs-target="#v-pills-notifications" type="button" role="tab" aria-controls="v-pills-notifications" aria-selected="false">
                <i class="bi bi-bell me-2 opacity-75"></i> Notifications
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab" aria-controls="v-pills-security" aria-selected="false">
                <i class="bi bi-shield-lock me-2 opacity-75"></i> Security
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-api-tab" data-bs-toggle="pill" data-bs-target="#v-pills-api" type="button" role="tab" aria-controls="v-pills-api" aria-selected="false">
                <i class="bi bi-code-slash me-2 opacity-75"></i> API & Webhooks
            </button>
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center" id="v-pills-seo-tab" data-bs-toggle="pill" data-bs-target="#v-pills-seo" type="button" role="tab" aria-controls="v-pills-seo" aria-selected="false">
                <i class="bi bi-search me-2 opacity-75"></i> SEO & Social
            </button>
            <hr class="text-muted opacity-25 my-2">
            <button class="nav-link text-start rounded-3 px-3 py-2 fw-medium d-flex align-items-center text-danger" id="v-pills-delete-tab" data-bs-toggle="pill" data-bs-target="#v-pills-delete" type="button" role="tab" aria-controls="v-pills-delete" aria-selected="false">
                <i class="bi bi-trash me-2 opacity-75"></i> Delete Store
            </button>
        </div>
    </div>

    <!-- Content Area -->
    <div class="col-md-9">
        <div class="tab-content" id="v-pills-tabContent">
            
            <!-- 1. GENERAL -->
            <div class="tab-pane fade show active" id="v-pills-general" role="tabpanel" aria-labelledby="v-pills-general-tab" tabindex="0">
                
                <!-- Store Information -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                        <h6 class="fw-bold mb-0">Store Information</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Store Name</label>
                                <input type="text" class="form-control bg-light border-0" value="My Premium Store">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Store Description</label>
                                <textarea class="form-control bg-light border-0" rows="2">Your premium destination for quality products.</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Store Email</label>
                                <input type="email" class="form-control bg-light border-0" value="contact@mystore.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Support Email</label>
                                <input type="email" class="form-control bg-light border-0" value="support@mystore.com">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Business Phone</label>
                                <input type="tel" class="form-control bg-light border-0" value="+1 (555) 123-4567">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Support Phone</label>
                                <input type="tel" class="form-control bg-light border-0" value="+1 (555) 987-6543">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Country</label>
                                <select class="form-select bg-light border-0">
                                    <option>United States</option>
                                    <option selected>Nepal</option>
                                    <option>India</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Province/State</label>
                                <input type="text" class="form-control bg-light border-0" value="Bagmati">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">City</label>
                                <input type="text" class="form-control bg-light border-0" value="Kathmandu">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Postal Code</label>
                                <input type="text" class="form-control bg-light border-0" value="44600">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Business Address</label>
                                <input type="text" class="form-control bg-light border-0" value="Baneshwor, Kathmandu, Nepal">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Regional Settings -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                        <h6 class="fw-bold mb-0">Regional Settings</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Currency</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>NPR - Nepalese Rupee</option>
                                    <option>USD - US Dollar</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Currency Symbol</label>
                                <input type="text" class="form-control bg-light border-0" value="Rs.">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Currency Position</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>Left (Rs. 100)</option>
                                    <option>Right (100 Rs.)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Language</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>English</option>
                                    <option>Nepali</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Time Zone</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>(GMT+05:45) Kathmandu</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Date Format</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>DD/MM/YYYY</option>
                                    <option>MM/DD/YYYY</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Time Format</label>
                                <select class="form-select bg-light border-0">
                                    <option selected>12 Hour (AM/PM)</option>
                                    <option>24 Hour</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Store Behavior & Order Config -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                                <h6 class="fw-bold mb-0">Store Behavior</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-3 d-flex justify-content-between align-items-center">
                                    <label class="form-label fw-semibold small mb-0">Store Status</label>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input shadow-none" type="checkbox" id="maintenanceMode">
                                    <label class="form-check-label text-dark small" for="maintenanceMode">Maintenance Mode</label>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Maintenance Message</label>
                                    <input type="text" class="form-control bg-light border-0 small" value="We are currently updating our store.">
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input shadow-none" type="checkbox" id="guestCheckout" checked>
                                    <label class="form-check-label text-dark small" for="guestCheckout">Guest Checkout</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input shadow-none" type="checkbox" id="customerRegistration" checked>
                                    <label class="form-check-label text-dark small" for="customerRegistration">Customer Registration</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                                <h6 class="fw-bold mb-0">Order Configuration</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Minimum Order Amount</label>
                                    <input type="number" class="form-control bg-light border-0" value="0">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Maximum Order Amount</label>
                                    <input type="number" class="form-control bg-light border-0" value="500000">
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input shadow-none" type="checkbox" id="allowOrderCancel" checked>
                                    <label class="form-check-label text-dark small" for="allowOrderCancel">Allow Order Cancellation (Before Shipping)</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input shadow-none" type="checkbox" id="allowOrderMod">
                                    <label class="form-check-label text-dark small" for="allowOrderMod">Allow Order Modification</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. BRANDING & ASSETS -->
            <div class="tab-pane fade" id="v-pills-branding" role="tabpanel" aria-labelledby="v-pills-branding-tab" tabindex="0">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                                <h6 class="fw-bold mb-0">Store Branding</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <label class="form-label fw-semibold small">Store Logo</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 100px; height: 60px;">
                                            <i class="bi bi-image text-muted fs-3"></i>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Replace</button>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold small">Favicon</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="bi bi-globe text-muted fs-4"></i>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Upload</button>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold small">Default Product Image</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-box-seam text-muted fs-4"></i>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Upload</button>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label fw-semibold small">Default Social/OG Image</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 120px; height: 60px;">
                                            <i class="bi bi-share text-muted fs-4"></i>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Upload</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                                <h6 class="fw-bold mb-0">Admin Branding</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-4">
                                    <label class="form-label fw-semibold small">Admin Logo</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-dark border rounded d-flex align-items-center justify-content-center" style="width: 100px; height: 40px;">
                                            <span class="text-white small fw-bold">ADMIN</span>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Replace</button>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label fw-semibold small">Login Page Logo</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 100px; height: 60px;">
                                            <i class="bi bi-box-arrow-in-right text-muted fs-3"></i>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Upload</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                                <h6 class="fw-bold mb-0">Brand Appearance</h6>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Primary Brand Color</label>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color border-0 bg-transparent p-0" value="#0d6efd" title="Choose your color">
                                            <input type="text" class="form-control bg-light border-0 form-control-sm w-50" value="#0d6efd">
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Secondary Brand Color</label>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color border-0 bg-transparent p-0" value="#6c757d" title="Choose your color">
                                            <input type="text" class="form-control bg-light border-0 form-control-sm w-50" value="#6c757d">
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Accent Color</label>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color border-0 bg-transparent p-0" value="#ffc107" title="Choose your color">
                                            <input type="text" class="form-control bg-light border-0 form-control-sm w-50" value="#ffc107">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. PAYMENTS -->
            <div class="tab-pane fade" id="v-pills-payments" role="tabpanel" aria-labelledby="v-pills-payments-tab" tabindex="0">
                <div class="row g-3 mb-4">
                    <!-- COD -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-success bg-opacity-10 text-success rounded p-3" style="font-size: 1.5rem;">
                                        <i class="bi bi-cash-stack"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0">Cash on Delivery</h6>
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">● ON</span>
                                        </div>
                                        <p class="text-muted small mb-1">Pay with cash upon delivery.</p>
                                        <p class="small text-secondary mb-0">Test Mode: <span class="fw-medium text-dark">OFF</span></p>
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#paymentConfigModal">Configure</button>
                            </div>
                        </div>
                    </div>
                    <!-- eSewa -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-success text-white rounded p-3 d-flex align-items-center justify-content-center font-monospace fw-bold" style="font-size: 1rem; width: 56px; height: 56px;">
                                        eSewa
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0">eSewa</h6>
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">● ON</span>
                                        </div>
                                        <p class="text-muted small mb-1">Online payment gateway.</p>
                                        <p class="small text-secondary mb-0">Test Mode: <span class="fw-medium text-warning">ON</span></p>
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#paymentConfigModal">Configure</button>
                            </div>
                        </div>
                    </div>
                    <!-- Khalti -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 opacity-75">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-purple text-white rounded p-3 d-flex align-items-center justify-content-center fw-bold" style="background-color:#5c2d91; font-size: 1rem; width: 56px; height: 56px;">
                                        K
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0">Khalti</h6>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">● OFF</span>
                                        </div>
                                        <p class="text-muted small mb-1">Digital wallet integration.</p>
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#paymentConfigModal">Configure</button>
                            </div>
                        </div>
                    </div>
                    <!-- Fonepay -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 opacity-75">
                            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-danger text-white rounded p-3 d-flex align-items-center justify-content-center fw-bold" style="font-size: 1rem; width: 56px; height: 56px;">
                                        F
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0">Fonepay</h6>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2">● OFF</span>
                                        </div>
                                        <p class="text-muted small mb-1">QR Code payments.</p>
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#paymentConfigModal">Configure</button>
                            </div>
                        </div>
                    </div>
                    <!-- Bank Transfer -->
