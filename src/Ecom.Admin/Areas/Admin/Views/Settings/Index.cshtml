                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">SMTP Host</label>
                                        <input type="text" class="form-control bg-light border-0" value="smtp.example.com">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">SMTP Port</label>
                                        <input type="text" class="form-control bg-light border-0" value="587">
