                <div class="tab-content" id="emailsms-tabContent">
                    <!-- Email Content -->
                    <div class="tab-pane fade show active" id="email-content" role="tabpanel" aria-labelledby="email-tab" tabindex="0">
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0">SMTP Configuration</h6>
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3">Send Test Email</button>
                            </div>
