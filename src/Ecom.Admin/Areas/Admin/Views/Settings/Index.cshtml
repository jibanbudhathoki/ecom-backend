                                        <input type="text" class="form-control bg-light border-0" value="no-reply@mystore.com">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Password</label>
                                        <input type="password" class="form-control bg-light border-0" value="••••••••••••">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">Encryption</label>
                                        <select class="form-select bg-light border-0">
                                            <option selected>TLS</option>
                                            <option>SSL</option>
                                            <option>None</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">From Name</label>
                                        <input type="text" class="form-control bg-light border-0" value="My Store">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">From Email</label>
                                        <input type="email" class="form-control bg-light border-0" value="no-reply@mystore.com">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Reply-To Email</label>
                                        <input type="email" class="form-control bg-light border-0" value="support@mystore.com">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
