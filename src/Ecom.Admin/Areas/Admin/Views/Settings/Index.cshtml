                                    @{ string[] emailNotifs = { "Email Verification", "Password Reset", "Order Confirmation", "Order Shipped", "Order Delivered", "Order Cancelled", "Payment Confirmation", "Refund Notification", "Low Stock", "New Customer", "New Review" }; }
                                    @foreach(var notif in emailNotifs)
