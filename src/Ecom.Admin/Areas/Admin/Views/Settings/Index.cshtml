                                    {
                                        <div class="col-md-6">
                                            <div class="form-check form-switch d-flex justify-content-between px-0 align-items-center">
                                                <label class="form-check-label text-dark fw-medium small mb-0" for="s_@notif.Replace(" ", "")">@notif</label>
