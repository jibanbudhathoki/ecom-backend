@model dynamic

@{
    var requestQuery = Context.Request.Query;
    var currentQuery = new Dictionary<string, string>();
    foreach (var key in requestQuery.Keys)
    {
        if (key.ToLower() != "pagenumber")
        {
            currentQuery[key] = requestQuery[key];
        }
    }
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            
            @if (Model.HasPreviousPage)
            {
                currentQuery["PageNumber"] = (Model.PageNumber - 1).ToString();
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="currentQuery">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                currentQuery["PageNumber"] = i.ToString();
                if (i == Model.PageNumber)
                {
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" asp-all-route-data="currentQuery">@i</a>
                    </li>
                }
            }

            @if (Model.HasNextPage)
            {
                currentQuery["PageNumber"] = (Model.PageNumber + 1).ToString();
                <li class="page-item">
                    <a class="page-link" asp-all-route-data="currentQuery">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }
        </ul>
    </nav>
}
