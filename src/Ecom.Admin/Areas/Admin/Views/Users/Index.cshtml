@{
    ViewData["Title"] = "Admin Users";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Admin Users</h2>
        <p class="text-muted mb-0 small">Manage staff access and permissions for your dashboard.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-medium" onclick="openInviteModal()">
            <i class="bi bi-person-plus me-1"></i> Invite User
        </button>
    </div>
</div>

<!-- Main Content -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 rounded-top-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <ul class="nav nav-pills custom-nav-pills">
                <li class="nav-item">
                    <a class="nav-link active px-3 py-2 rounded-pill small fw-medium" href="#">All Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted px-3 py-2 rounded-pill small fw-medium" href="#">Active</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted px-3 py-2 rounded-pill small fw-medium" href="#">Pending Invites</a>
                </li>
            </ul>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-0 rounded-start-pill ps-3"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-0 rounded-end-pill shadow-none" placeholder="Search users...">
                </div>
                <button class="btn btn-sm btn-light border rounded-pill px-3"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 py-3 text-muted small fw-semibold border-bottom-0">User</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Role</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Status</th>
                    <th class="py-3 text-muted small fw-semibold border-bottom-0">Last Login</th>
                    <th class="pe-4 py-3 text-end text-muted small fw-semibold border-bottom-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                <!-- User 1 (Admin) -->
                <tr>
                    <td class="ps-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                J
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 small text-dark">Jiban Budhathoki <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill ms-1" style="font-size:0.65rem">You</span></h6>
                                <p class="text-muted small mb-0">jiban@example.com</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3">
                        <span class="fw-medium small text-dark"><i class="bi bi-shield-lock-fill text-primary me-1"></i> Admin</span>
                    </td>
                    <td class="py-3">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">Active</span>
                    </td>
                    <td class="py-3 text-muted small">Just now</td>
                    <td class="pe-4 py-3 text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li><button class="dropdown-item small" onclick="openEditRoleModal()"><i class="bi bi-pencil me-2 text-muted"></i> Edit Role</button></li>
                            </ul>
                        </div>
                    </td>
                </tr>
                
                <!-- User 2 (Editor) -->
                <tr>
                    <td class="ps-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                AS
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 small text-dark">Alice Smith</h6>
                                <p class="text-muted small mb-0">alice@example.com</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3">
                        <span class="fw-medium small text-dark"><i class="bi bi-pencil-square text-info me-1"></i> Store Editor</span>
                    </td>
                    <td class="py-3">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 user-status">Active</span>
                    </td>
                    <td class="py-3 text-muted small">2 hours ago</td>
                    <td class="pe-4 py-3 text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li><button class="dropdown-item small" onclick="openEditRoleModal()"><i class="bi bi-pencil me-2 text-muted"></i> Edit Role</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item small text-warning" onclick="suspendUser(this)"><i class="bi bi-pause-circle me-2"></i> Suspend Access</button></li>
                                <li><button class="dropdown-item small text-danger" onclick="deleteRow(this)"><i class="bi bi-trash me-2"></i> Remove User</button></li>
                            </ul>
                        </div>
                    </td>
                </tr>

                <!-- User 3 (Pending Invite) -->
                <tr>
                    <td class="ps-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 small text-dark text-muted fst-italic">Awaiting acceptance...</h6>
                                <p class="text-muted small mb-0">mark.marketing@example.com</p>
                            </div>
                        </div>
                    </td>
                    <td class="py-3">
                        <span class="fw-medium small text-dark"><i class="bi bi-megaphone text-warning me-1"></i> Marketing</span>
                    </td>
                    <td class="py-3">
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2">Invited</span>
                    </td>
                    <td class="py-3 text-muted small">Never</td>
                    <td class="pe-4 py-3 text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li><button class="dropdown-item small" onclick="showToast('Invitation resent to mark.marketing@example.com', 'success')"><i class="bi bi-send me-2 text-muted"></i> Resend Invite</button></li>
                                <li><button class="dropdown-item small text-danger" onclick="deleteRow(this)"><i class="bi bi-x-circle me-2"></i> Cancel Invite</button></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Invite User -->
<div class="modal fade" id="inviteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Invite New User</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-4">Send an invitation email to add a new staff member to your dashboard.</p>
                
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                    <input type="email" class="form-control shadow-none rounded-3" placeholder="colleague@example.com">
                </div>
                
                <div class="mb-4">
                    <label class="form-label small fw-semibold">Assign Role <span class="text-danger">*</span></label>
                    <select class="form-select shadow-none rounded-3">
                        <option value="editor">Store Editor (Products & Orders)</option>
                        <option value="marketing">Marketing (Promotions & Banners)</option>
                        <option value="support">Customer Support (Reviews & Customers)</option>
                        <option value="admin">Admin (Full Access)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitInvite()"><i class="bi bi-send me-1"></i> Send Invite</button>
            </div>
        </div>
    </div>
</div>

<!-- Toasts Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="actionToast" class="toast align-items-center text-white bg-success border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastMessage">
                Action completed successfully.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .custom-nav-pills .nav-link {
        color: #6c757d;
    }
    .custom-nav-pills .nav-link.active {
        background-color: #e9ecef;
        color: #212529;
    }
</style>

@section Scripts {
    <script>
        let inviteModal;

        document.addEventListener('DOMContentLoaded', function() {
            inviteModal = new bootstrap.Modal(document.getElementById('inviteUserModal'));
            document.body.appendChild(document.getElementById('inviteUserModal'));
        });

        function showToast(message, type = 'success') {
            const toastEl = document.getElementById('actionToast');
            const toastMsg = document.getElementById('toastMessage');
            
            toastEl.classList.remove('bg-success', 'bg-danger', 'bg-warning');
            toastEl.classList.add('bg-' + type);
            
            toastMsg.innerText = message;
            
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function openInviteModal() {
            inviteModal.show();
        }

        function submitInvite() {
            inviteModal.hide();
            showToast('Invitation sent successfully!', 'success');
        }
        
        function openEditRoleModal() {
            // For mock purposes, just show toast
            showToast('Edit Role modal would open here.', 'success');
        }

        function suspendUser(btn) {
            const row = btn.closest('tr');
            const statusBadge = row.querySelector('.user-status');
            
            if (statusBadge) {
                if (btn.innerText.includes('Suspend')) {
                    statusBadge.className = 'badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 user-status';
                    statusBadge.innerText = 'Suspended';
                    btn.innerHTML = '<i class="bi bi-play-circle me-2"></i> Reactivate Access';
                    btn.classList.remove('text-warning');
                    btn.classList.add('text-success');
                    showToast('User access has been suspended.', 'warning');
                } else {
                    statusBadge.className = 'badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 user-status';
                    statusBadge.innerText = 'Active';
                    btn.innerHTML = '<i class="bi bi-pause-circle me-2"></i> Suspend Access';
                    btn.classList.remove('text-success');
                    btn.classList.add('text-warning');
                    showToast('User access has been restored.', 'success');
                }
            }
        }

        function deleteRow(btn) {
            const row = btn.closest('tr');
            row.style.transition = "opacity 0.3s";
            row.style.opacity = "0";
            setTimeout(() => {
                row.remove();
                showToast('User removed from the system.', 'success');
            }, 300);
        }
    </script>
}
